{% comment %}
  Section 12: Pre-Purchase FAQ
  Accordion: Native HTML5 <details> with custom + / − CSS summary toggle icons.
{% endcomment %}
<section class="faq-section py-16 reveal-on-scroll">
  <div class="container max-w-3xl">
    <div class="section-header">
      <span class="badge-forest mb-3">{{ section.settings.badge | default: 'شفافية وثقة' }}</span>
      <h2 class="type-h2">{{ section.settings.title | default: 'الأسئلة الشائعة حول المنتجات والشحن' }}</h2>
      <p class="section-subtitle">{{ section.settings.subtitle | default: 'كل ما تود معرفته عن نقاء مكوناتنا، سلامة الاستخدام العائلي، وطريقة الشحن والمعاينة' }}</p>
    </div>

    <div class="faq-list flex flex-col gap-4">
      <details class="faq-item">
        <summary class="faq-summary">
          <span>كيف تتم عملية المعاينة والدفع عند الاستلام بالمغرب؟</span>
          <span class="faq-icon">+</span>
        </summary>
        <div class="faq-answer">
          نحن نوفر خدمة الدفع عند الاستلام (COD) الموثوقة لجميع مدن وقرى المملكة المغربية. عند وصول موزع الشحن لباب منزلك، تتاح لك فرصة فتح الشحنة ومعاينة العبوة والتأكد من سلامتها ومطابقتها قبل تسليم أي مبلغ نقدي للموزع.
        </div>
      </details>

      <details class="faq-item">
        <summary class="faq-summary">
          <span>كيف أتأكد من نقاء وأصالة الزيوت والمكونات العضوية؟</span>
          <span class="faq-icon">+</span>
        </summary>
        <div class="faq-answer">
          تُستخلص جميع زيوتنا (الأرغان والتين الشوكي) عبر العصر البارد الأول في معاصرنا المعتمدة بسوس والأطلس. نضمن لك خلوها تماماً من أي معطرات اصطناعية أو كحول أو زيوت معدنية مخففة، ونرفق معها ضمان الأصالة والنقاء.
        </div>
      </details>

      <details class="faq-item">
        <summary class="faq-summary">
          <span>كم يستغرق الشحن وما هي تكلفة التوصيل؟</span>
          <span class="faq-icon">+</span>
        </summary>
        <div class="faq-answer">
          التوصيل مجاني 100% لجميع الطلبات بقيمة 200 د.م. أو أكثر. يستغرق التوصيل من 24 إلى 48 ساعة في المدن الرئيسية (الدار البيضاء، الرباط، مراكش، طنجة، فاس، أكادير)، ومن 48 إلى 72 ساعة لباقي المناطق والقرى.
        </div>
      </details>

      <details class="faq-item">
        <summary class="faq-summary">
          <span>هل المنتجات آمنة للاستخدام اليومي ولجميع أفراد العائلة؟</span>
          <span class="faq-icon">+</span>
        </summary>
        <div class="faq-answer">
          نعم، بالتأكيد. تم تطوير جميع مستحضرات ناتورا بمكونات نباتية نقية خالية من البارابين، السلفات، والعطور الاصطناعية. تركيباتنا لطيفة جداً وتناسب جميع أنواع البشرة (بما فيها الحساسة) وهي خيار آمن يومياً للكبار والأطفال.
        </div>
      </details>
    </div>
  </div>
</section>

<style>
  .faq-section {
    background-color: var(--color-bg-primary);
  }

  .faq-item {
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    padding: 1.15rem 1.35rem;
    box-shadow: var(--shadow-sm);
    transition: border-color var(--transition-base), box-shadow var(--transition-base);
  }

  .faq-item[open] {
    border-color: rgba(45, 95, 62, 0.3);
    box-shadow: var(--shadow-md);
  }

  .faq-summary {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-charcoal-dark);
    cursor: pointer;
    user-select: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    list-style: none;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-icon {
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--color-forest);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), color 0.35s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
  }

  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    color: var(--color-terracotta);
  }

  .faq-answer {
    padding-top: 0.95rem;
    margin-top: 0.75rem;
    border-top: 1px dashed rgba(229, 224, 213, 0.7);
    color: var(--color-text-muted);
    font-size: 0.925rem;
    line-height: 1.7;
  }
</style>

{% schema %}
{
  "name": "الأسئلة الشائعة",
  "settings": [
    { "type": "text", "id": "badge", "label": "نص البادج", "default": "شفافية وثقة" },
    { "type": "text", "id": "title", "label": "العنوان", "default": "الأسئلة الشائعة حول المنتجات والشحن" },
    { "type": "textarea", "id": "subtitle", "label": "الوصف", "default": "كل ما تود معرفته عن نقاء مكوناتنا، سلامة الاستخدام العائلي، وطريقة الشحن والمعاينة" }
  ],
  "presets": [{ "name": "الأسئلة الشائعة" }]
}
{% endschema %}
