{% comment %}
  Section 5: Best Sellers / Featured Collection
  — Schema-controlled collection + product count + heading
  — "View All" CTA below grid
  — No emojis in fallback state
  — Proper placeholder with SVG icon
{% endcomment %}

<section class="featured-collection py-16 reveal-on-scroll" style="background-color: var(--color-bg-secondary);">
  <div class="container">
    <div class="section-header">
      <span class="badge-forest mb-4" style="display: inline-flex;">{{ section.settings.badge | default: 'الأكثر مبيعاً' }}</span>
      <h2 class="type-h2">{{ section.settings.title | default: 'منتجاتنا الأكثر طلباً' }}</h2>
      <p class="section-subtitle">{{ section.settings.subtitle | default: 'مستحضرات حازت على ثقة أكثر من 10,000 سيدة في المغرب' }}</p>
    </div>

    <div class="products-grid">
      {%- assign featured_collection = section.settings.collection -%}
      {%- if featured_collection != blank and featured_collection.products.size > 0 -%}
        {%- for product in featured_collection.products limit: section.settings.products_to_show -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <div class="product-card product-card--placeholder">
            <div class="product-card__image-wrapper">
              <div class="product-card__placeholder">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="rgba(45,95,62,0.3)" stroke-width="1.5" aria-hidden="true">
                  <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/>
                  <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
                </svg>
              </div>
            </div>
            <div class="product-card__content">
              <div>
                <div class="product-card__placeholder-title" style="height:1rem;background:var(--color-border-subtle);border-radius:4px;margin-bottom:0.5rem;"></div>
                <div class="product-card__placeholder-title" style="height:1rem;background:var(--color-border-subtle);border-radius:4px;width:60%;"></div>
              </div>
              <div class="product-card__placeholder-title" style="height:2.75rem;background:var(--color-border-subtle);border-radius:var(--radius-full);margin-top:1rem;"></div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.show_view_all -%}
      <div class="products-view-all">
        <a
          href="{{ featured_collection.url | default: '/collections/all' }}"
          class="btn-secondary"
          style="display: inline-flex;"
        >
          {{ section.settings.view_all_text | default: 'عرض جميع المنتجات' }}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" style="margin-inline-start:0.5rem;"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .products-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }
  @media (max-width: 1024px) {
    .products-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 768px) {
    .products-grid { grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  }
  @media (max-width: 400px) {
    .products-grid { gap: 0.75rem; }
  }
  .products-view-all {
    text-align: center;
    margin-top: 2.5rem;
  }
</style>

{% schema %}
{
  "name": "الأكثر مبيعاً",
  "settings": [
    { "type": "text", "id": "badge", "label": "نص البادج", "default": "الأكثر مبيعاً" },
    { "type": "text", "id": "title", "label": "العنوان", "default": "منتجاتنا الأكثر طلباً" },
    { "type": "textarea", "id": "subtitle", "label": "الوصف", "default": "مستحضرات حازت على ثقة أكثر من 10,000 سيدة في المغرب" },
    { "type": "collection", "id": "collection", "label": "المجموعة المعروضة" },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 4,
      "default": 4,
      "label": "عدد المنتجات"
    },
    { "type": "checkbox", "id": "show_view_all", "label": "عرض زر 'عرض الكل'", "default": true },
    { "type": "text", "id": "view_all_text", "label": "نص زر 'عرض الكل'", "default": "عرض جميع المنتجات" }
  ],
  "presets": [{ "name": "الأكثر مبيعاً" }]
}
{% endschema %}
