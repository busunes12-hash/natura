{% comment %}
  Section 3.5: Search & Predictive Search Results
{% endcomment %}
<section class="main-search-section py-12" style="background-color: var(--color-bg-primary);">
  <div class="container">
    <div class="search-header text-center max-w-xl mx-auto mb-12">
      <h1 class="type-h1 mb-4">البحث في المنتجات</h1>
      <form action="{{ routes.search_url }}" method="get" class="flex gap-2">
        <input
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="ابحثي عن سيروم، كريم، أو زيوت..."
          class="form-input text-lg py-3 flex-grow"
          aria-label="كلمة البحث"
        >
        <button type="submit" class="btn-primary py-3 px-6 whitespace-nowrap">
          بحث
        </button>
      </form>
    </div>

    {%- if search.performed -%}
      <div class="search-results-info text-center mb-6">
        <p class="text-muted">
          نتائج البحث عن: <strong class="text-forest">"{{ search.terms }}"</strong> ({{ search.results_count }} نتيجة)
        </p>
      </div>

      <div class="products-grid">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            {% render 'product-card', product: item %}
          {%- endif -%}
        {%- else -%}
          <div class="no-results text-center py-12 col-span-full">
            <span style="width:56px;height:56px;display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;background:rgba(45,95,62,0.1);border-radius:50%;color:var(--color-forest);">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            </span>
            <h3 class="font-bold text-lg">لم نجد أي نتائج مطابقة لبحثكِ</h3>
            <p class="text-muted text-sm mt-1">جربي البحث بكلمات أخرى مثل "سيروم" أو "أرغان"</p>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .products-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }
  @media (max-width: 1024px) {
    .products-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 640px) {
    .products-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 0.75rem; }
  }
</style>

{% schema %}
{
  "name": "صفحة البحث",
  "settings": []
}
{% endschema %}
