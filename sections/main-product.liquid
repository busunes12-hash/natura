{% comment %}
  Section 3.3 & 11: Main Product Detail Page with JSON-LD Structured Data Schema & Sticky Mobile COD Bar
{% endcomment %}
{{ 'component-forms.css' | asset_url | stylesheet_tag }}

<section class="main-product-section py-12 md:py-16">
  <div class="container">
    {% render 'breadcrumb' %}

    <div class="product-main-grid grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-14 mt-6">
      <!-- Column 1: Product Gallery -->
      <div class="product-gallery flex flex-col gap-6">
        <div class="main-image-wrapper rounded-lg shadow-md overflow-hidden bg-surface">
          {%- if product.featured_media -%}
            <img
              src="{{ product.featured_media | image_url: width: 800 }}"
              alt="{{ product.title | escape }}"
              class="w-full h-full object-cover main-product-img"
              loading="eager"
              width="800"
              height="800"
            >
          {%- else -%}
            <div class="flex items-center justify-center h-full bg-cream text-forest text-6xl">
              {% render 'icon', name: 'leaf' %}
            </div>
          {%- endif -%}
        </div>

        {%- if product.media.size > 1 -%}
          <div class="product-thumbnails">
            {%- for media in product.media -%}
              <button
                type="button"
                class="thumbnail-btn {% if forloop.first %}is-active{% endif %}"
                data-image-src="{{ media | image_url: width: 800 }}"
                aria-label="عرض الصورة {{ forloop.index }}"
              >
                <img src="{{ media | image_url: width: 150 }}" alt="{{ media.alt | default: product.title | escape }}" width="72" height="72" loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <!-- Clinical Study Results Box -->
        {% render 'clinical-results' %}
      </div>

      <!-- Column 2: Product Info & COD Order Form -->
      <div class="product-info flex flex-col gap-6">
        <div class="tags-row flex items-center gap-2">
          <span class="badge-forest flex items-center gap-1.5">
            <span class="w-3.5 h-3.5 inline-flex items-center justify-center">{% render 'icon', name: 'leaf' %}</span>
            <span>عضوي 100%</span>
          </span>
          <span class="badge-terracotta-subtle flex items-center gap-1.5">
            <span class="w-3.5 h-3.5 inline-flex items-center justify-center">{% render 'icon', name: 'badge-check' %}</span>
            <span>مختبر طبياً</span>
          </span>
        </div>

        <h1 class="type-h1 product-title">{{ product.title | default: "زيت الأرغان المغربي النقي 100% — معصور على البارد (100 مل)" }}</h1>

        <div class="rating-row flex items-center gap-2.5 text-sm">
          <div class="stars flex gap-1">
            {%- for i in (1..5) -%}
              <span class="star-gold inline-flex items-center justify-center w-4 h-4">{% render 'icon', name: 'star' %}</span>
            {%- endfor -%}
          </div>
          <span class="font-semibold text-forest">4.9/5 (1,540 تقييم عملاء موثق)</span>
        </div>

        {% render 'price', product: product %}

        <!-- Stock Scarcity Urgency Badge Snippet -->
        {% render 'scarcity-badge', product: product %}

        <!-- Tiered Volume Discount Bundle Selector -->
        {% render 'bundle-selector', product: product %}

        <!-- Accelerated 1-Click Direct COD Form -->
        {% render 'cod-express-form', product: product %}

        {% form 'product', product, class: 'product-form flex flex-col gap-4 hidden' %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <button type="submit" name="add" class="hidden">إضافة إلى السلة</button>
        {% endform %}

        {% render 'trust-bar' %}

        <!-- Shopify OS 2.0 App Blocks Injection Point -->
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}
          {%- endcase -%}
        {%- endfor -%}

        <!-- Accordions -->
        <div class="product-accordions flex flex-col gap-3.5 mt-2">
          <details class="pdp-accordion-item">
            <summary class="pdp-accordion-summary">
              <span class="flex items-center gap-2.5">
                <span class="w-4 h-4 text-forest inline-flex items-center justify-center">{% render 'icon', name: 'leaf' %}</span>
                <span>المكونات الطبيعية ومصدرها الأصيل</span>
              </span>
              <span class="accordion-chevron">↓</span>
            </summary>
            <div class="pdp-accordion-content">
              <p class="text-sm text-muted leading-relaxed">زيت أرغان مغربي أصلي 100% معصور على البارد من منطقة سوس، خالٍ تماماً من الزيوت الممددة أو العطور الاصطناعية أو المواد الحافظة.</p>
            </div>
          </details>

          <details class="pdp-accordion-item">
            <summary class="pdp-accordion-summary">
              <span class="flex items-center gap-2.5">
                <span class="w-4 h-4 text-forest inline-flex items-center justify-center">{% render 'icon', name: 'sparkle' %}</span>
                <span>طريقة الاستخدام العائلية اليومية</span>
              </span>
              <span class="accordion-chevron">↓</span>
            </summary>
            <div class="pdp-accordion-content">
              <p class="text-sm text-muted leading-relaxed">ضعي قطرات قليلة على البشرة أو الشعر وتدلك بحركات لطيفة. مناسب للاستخدام اليومي الآمن لجميع أفراد الأسرة الكبار والأطفال.</p>
            </div>
          </details>

          <details class="pdp-accordion-item">
            <summary class="pdp-accordion-summary">
              <span class="flex items-center gap-2.5">
                <span class="w-4 h-4 text-forest inline-flex items-center justify-center">{% render 'icon', name: 'truck' %}</span>
                <span>سياسة الشحن والمعاينة عند الاستلام بالمغرب</span>
              </span>
              <span class="accordion-chevron">↓</span>
            </summary>
            <div class="pdp-accordion-content">
              <p class="text-sm text-muted leading-relaxed">توصيل سريع 24-48 ساعة لجميع مدن المملكة. تتاح لكِ فرصة فتح الشحنة ومعاينة العبوة والتأكد من سلامتها قبل تسليم أي مبلغ نقدي للموزع. الشحن مجاني لجميع الطلبات فوق 200 د.م.</p>
            </div>
          </details>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Mobile Sticky COD Buy Bar -->
<div class="sticky-mobile-buy-bar">
  <div class="sticky-bar-info">
    <h4 class="font-semibold text-xs line-clamp-1 sticky-title">{{ product.title | default: "زيت الأرغان المغربي النقي 100%" }}</h4>
    <span class="font-bold text-forest text-sm">{{ product.price | default: 19900 | money_without_currency }} د.م.</span>
  </div>
  <button
    type="button"
    class="btn-terracotta text-xs sm:text-sm py-2.5 px-4 whitespace-nowrap flex items-center gap-1.5 sticky-btn"
    data-quick-add="{{ product.selected_or_first_available_variant.id }}"
  >
    <span class="w-4 h-4 inline-flex items-center justify-center">{% render 'icon', name: 'truck' %}</span>
    <span>إضافة إلى السلة — دفع عند الاستلام</span>
  </button>
</div>

<style>
  .main-product-section {
    background-color: var(--color-bg-primary);
  }

  .main-image-wrapper {
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-subtle);
    box-shadow: 0 16px 40px rgba(31, 36, 30, 0.05);
    background-color: var(--color-bg-surface);
  }

  .main-product-img {
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .main-image-wrapper:hover .main-product-img {
    transform: scale(1.025);
  }

  .product-title {
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    line-height: 1.3;
    font-weight: 700;
    color: var(--color-charcoal-dark);
  }

  .pdp-cta-btn {
    min-height: 54px;
    border-radius: var(--radius-full);
  }

  /* Accordion Quiet Luxury Styling */
  .pdp-accordion-item {
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    padding: 1.1rem 1.25rem;
    transition: border-color var(--transition-base), box-shadow var(--transition-base);
    box-shadow: var(--shadow-sm);
  }

  .pdp-accordion-item[open] {
    border-color: rgba(45, 95, 62, 0.3);
    box-shadow: var(--shadow-md);
  }

  .pdp-accordion-summary {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1rem;
    color: var(--color-charcoal-dark);
    cursor: pointer;
    user-select: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    list-style: none;
  }

  .pdp-accordion-summary::-webkit-details-marker {
    display: none;
  }

  .accordion-chevron {
    font-size: 0.85rem;
    color: var(--color-forest);
    transition: transform var(--transition-base);
  }

  .pdp-accordion-item[open] .accordion-chevron {
    transform: rotate(180deg);
  }

  .pdp-accordion-content {
    padding-top: 0.85rem;
    margin-top: 0.65rem;
    border-top: 1px dashed rgba(229, 224, 213, 0.7);
  }

  /* Mobile Sticky COD Bar */
  .sticky-mobile-buy-bar {
    display: none;
  }

  @media (max-width: 767px) {
    .sticky-mobile-buy-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      position: fixed;
      bottom: 0;
      inset-inline-start: 0;
      inset-inline-end: 0;
      z-index: 400;
      padding: 0.75rem 1rem;
      background-color: rgba(255, 255, 255, 0.94);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-top: 1px solid var(--color-border-subtle);
      box-shadow: 0 -8px 24px rgba(31, 36, 30, 0.08);
    }

    .sticky-bar-info {
      flex: 1;
      min-width: 0;
    }

    .sticky-title {
      font-family: var(--font-heading);
    }

    .sticky-btn {
      min-height: 48px;
      padding-inline: 1rem;
      border-radius: var(--radius-full);
    }
  }
</style>

<!-- JSON-LD Structured Data Schema for Google Rich Snippets (Blueprint Section 11) -->
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | default: "زيت الأرغان المغربي النقي 100% — معصور على البارد (100 مل)" | json }},
  "image": [ {{ product.featured_media | image_url: width: 800 | default: "luxury-hero-skincare.jpg" | prepend: 'https:' | json }} ],
  "description": {{ product.description | strip_html | default: "زيت أرغان مغربي أصلي 100% معصور على البارد من منطقة سوس، خالي من المواد الكيميائية والعطور." | json }},
  "brand": { "@type": "Brand", "name": "NATURA Moroccan Natural Skincare" },
  "offers": {
    "@type": "Offer",
    "priceCurrency": "MAD",
    "price": "{{ product.price | money_without_currency | default: '199.00' }}",
    "itemCondition": "https://schema.org/NewCondition",
    "availability": "https://schema.org/InStock"
  }
}
</script>

{% schema %}
{
  "name": "تفاصيل المنتج الرئيسية",
  "settings": [],
  "blocks": [
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
