{% comment %}
  Section 3.3 & 11: Main Product Detail Page with JSON-LD Structured Data Schema & Sticky Mobile COD Bar
  Phase 4 Rebuild: Tokenized styling, clean accordions, optimized CRO hierarchy
{% endcomment %}
{{ 'component-forms.css' | asset_url | stylesheet_tag }}

<section class="main-product-section py-12 md:py-16">
  <div class="container">
    {% render 'breadcrumb' %}

    <div class="product-main-grid grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-14 mt-6">
      <!-- Column 1: Product Gallery -->
      <div class="product-gallery flex flex-col gap-6">
        <div class="main-image-wrapper rounded-lg shadow-md overflow-hidden bg-surface relative group" id="ProductGalleryWrapper">
          {%- if product.featured_media -%}
            {%- if product.featured_media.media_type == 'video' -%}
              {{ product.featured_media | video_tag: autoplay: true, loop: true, muted: true, controls: false, class: "w-full h-full object-cover main-product-img" }}
            {%- else -%}
              <img
                src="{{ product.featured_media | image_url: width: 800 }}"
                alt="{{ product.title | escape }}"
                class="w-full h-full object-cover main-product-img cursor-zoom-in"
                loading="eager"
                width="800"
                height="800"
                id="MainProductImage"
              >
            {%- endif -%}
          {%- else -%}
            <img
              src="{{ 'luxury-hero-skincare.jpg' | asset_url }}"
              alt="{{ product.title | escape }}"
              class="w-full h-full object-cover main-product-img"
              width="800"
              height="800"
              loading="eager"
            >
          {%- endif -%}

          <button type="button" class="gallery-zoom-trigger absolute bottom-3 left-3 bg-surface/90 backdrop-blur-md p-2 rounded-full text-forest shadow-md hover:bg-surface transition flex items-center justify-center" id="GalleryZoomBtn" aria-label="تكبير الصورة">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
          </button>
        </div>

        {%- if product.media.size > 1 -%}
          <div class="product-thumbnails flex gap-3 overflow-x-auto pb-2 scroll-smooth" id="ProductThumbnails">
            {%- for media in product.media -%}
              <button
                type="button"
                class="thumbnail-btn rounded-md overflow-hidden border border-subtle-token flex-shrink-0 transition {% if forloop.first %}is-active{% endif %}"
                data-image-src="{{ media | image_url: width: 800 }}"
                data-media-type="{{ media.media_type }}"
                aria-label="عرض الصورة {{ forloop.index }}"
              >
                {%- if media.media_type == 'video' -%}
                  <div class="relative w-[72px] h-[72px] bg-dark flex items-center justify-center">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="white"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                  </div>
                {%- else -%}
                  <img src="{{ media | image_url: width: 150 }}" alt="{{ media.alt | default: product.title | escape }}" width="72" height="72" loading="lazy">
                {%- endif -%}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <!-- Clinical Study Results Box -->
        {% render 'clinical-results' %}
      </div>

      <!-- Column 2: Product Info & COD Order Form -->
      <div class="product-info flex flex-col gap-6">
        <div class="tags-row flex items-center gap-2">
          <span class="badge-forest flex items-center gap-1.5">
            <span class="w-3.5 h-3.5 inline-flex items-center justify-center">{% render 'icon', name: 'leaf' %}</span>
            <span>عضوي 100%</span>
          </span>
          <span class="badge-terracotta-subtle flex items-center gap-1.5">
            <span class="w-3.5 h-3.5 inline-flex items-center justify-center">{% render 'icon', name: 'badge-check' %}</span>
            <span>مختبر طبياً</span>
          </span>
        </div>

        <h1 class="type-h1 product-title">{{ product.title | default: "زيت الأرغان المغربي النقي 100% — معصور على البارد (100 مل)" }}</h1>

        <div class="rating-row flex items-center gap-2.5 text-sm">
          <div class="stars flex gap-1">
            {%- for i in (1..5) -%}
              <span class="star-gold inline-flex items-center justify-center w-4 h-4">{% render 'icon', name: 'star' %}</span>
            {%- endfor -%}
          </div>
          <span class="font-semibold text-forest">4.9/5 (1,540 تقييم عملاء موثق)</span>
        </div>

        {% render 'price', product: product %}

        <!-- Stock Scarcity Urgency Badge Snippet -->
        {% render 'scarcity-badge', product: product %}

        <!-- Tiered Volume Discount Bundle Selector -->
        {% render 'bundle-selector', product: product %}

        <!-- Accelerated 1-Click Direct COD Form -->
        {% render 'cod-express-form', product: product %}

        {% form 'product', product, class: 'product-form flex flex-col gap-4 hidden' %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <button type="submit" name="add" class="hidden">إضافة إلى السلة</button>
        {% endform %}

        {% render 'trust-bar' %}

        <!-- Shopify OS 2.0 App Blocks Injection Point -->
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}
          {%- endcase -%}
        {%- endfor -%}

        <!-- Accordions -->
        <div class="product-accordions flex flex-col gap-3.5 mt-2">
          <details class="pdp-accordion-item">
            <summary class="pdp-accordion-summary">
              <span class="flex items-center gap-2.5">
                <span class="w-4 h-4 text-forest inline-flex items-center justify-center">{% render 'icon', name: 'leaf' %}</span>
                <span>إكسير الطبيعة المغربية: المكونات العضوية 100% ومصدرها الأصيل</span>
              </span>
              <span class="accordion-chevron">↓</span>
            </summary>
            <div class="pdp-accordion-content">
              <p class="text-sm text-muted leading-relaxed">زيت أرغان مغربي أصلي 100% مستخلص عبر العصر البارد الأول في معاصرنا المعتمدة بمنطقة سوس والجبال. خالٍ تماماً من الزيوت الممددة أو العطور الاصطناعية أو المواد الحافظة.</p>
            </div>
          </details>

          <details class="pdp-accordion-item">
            <summary class="pdp-accordion-summary">
              <span class="flex items-center gap-2.5">
                <span class="w-4 h-4 text-forest inline-flex items-center justify-center">{% render 'icon', name: 'sparkle' %}</span>
                <span>طقوس العناية اليومية ورغد الاستخدام للبشرة والشعر</span>
              </span>
              <span class="accordion-chevron">↓</span>
            </summary>
            <div class="pdp-accordion-content">
              <p class="text-sm text-muted leading-relaxed">ضعي من 3 إلى 5 قطرات دافئة بين كفيكِ، وتُدلّك بها البشرة أو نهايات الشعر بحركات دائرية لطيفة. تركيبة نباتية خفيفة وسريعة الامتصاص مناسبة للاستخدام اليومي الآمن لجميع أفراد الأسرة.</p>
            </div>
          </details>

          <details class="pdp-accordion-item">
            <summary class="pdp-accordion-summary">
              <span class="flex items-center gap-2.5">
                <span class="w-4 h-4 text-forest inline-flex items-center justify-center">{% render 'icon', name: 'truck' %}</span>
                <span>ضمان معاينة الشحنة والتوصيل الفاخر 24-48 ساعة بالمغرب</span>
              </span>
              <span class="accordion-chevron">↓</span>
            </summary>
            <div class="pdp-accordion-content">
              <p class="text-sm text-muted leading-relaxed">توصيل آمن وسريع خلال 24 إلى 48 ساعة لجميع مدن المملكة. تتاح لكِ فرصة فتح الشحنة ومعاينة القارورة والتأكد من سلامتها ونقائها قبل تسليم أي مبلغ للموزع. الشحن مجاني لجميع الطلبات فوق 200 د.م.</p>
            </div>
          </details>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Mobile Sticky COD Buy Bar -->
<div class="sticky-mobile-buy-bar">
  <div class="sticky-bar-info">
    <h4 class="font-semibold text-xs line-clamp-1 sticky-title">{{ product.title | default: "زيت الأرغان المغربي النقي 100%" }}</h4>
    <span class="font-bold text-forest text-sm">{{ product.price | default: 19900 | money_without_currency }} د.م.</span>
  </div>
  <button
    type="button"
    class="btn-primary text-xs sm:text-sm py-2.5 px-4 whitespace-nowrap flex items-center gap-1.5 sticky-btn"
    id="StickyMobileCodBtn"
    data-scroll-to-cod="true"
  >
    <span class="w-4 h-4 inline-flex items-center justify-center">{% render 'icon', name: 'truck' %}</span>
    <span>اطلبي الآن — الدفع عند الاستلام</span>
  </button>
</div>

<style>
  .main-product-section {
    background-color: var(--color-bg-primary);
  }

  .main-image-wrapper {
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-subtle);
    box-shadow: var(--shadow-sm);
    background-color: var(--color-bg-surface);
  }

  .main-product-img {
    transition: transform var(--transition-smooth);
  }

  .main-image-wrapper:hover .main-product-img {
    transform: scale(1.025);
  }

  .product-title {
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    line-height: 1.3;
    font-weight: 700;
    color: var(--color-charcoal-dark);
  }

  .thumbnail-btn.is-active {
    border-color: var(--color-forest);
    box-shadow: 0 0 0 2px var(--color-forest);
  }

  /* Accordion Quiet Luxury Styling */
  .pdp-accordion-item {
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    padding: 1.1rem 1.25rem;
    transition: border-color var(--transition-base), box-shadow var(--transition-base);
    box-shadow: var(--shadow-sm);
  }

  .pdp-accordion-item[open] {
    border-color: rgba(var(--color-forest-rgb), 0.3);
    box-shadow: var(--shadow-md);
  }

  .pdp-accordion-summary {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1rem;
    color: var(--color-charcoal-dark);
    cursor: pointer;
    user-select: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    list-style: none;
  }

  .pdp-accordion-summary::-webkit-details-marker {
    display: none;
  }

  .accordion-chevron {
    font-size: 0.85rem;
    color: var(--color-forest);
    transition: transform var(--transition-base);
  }

  .pdp-accordion-item[open] .accordion-chevron {
    transform: rotate(180deg);
  }

  .pdp-accordion-content {
    padding-top: 0.85rem;
    margin-top: 0.65rem;
    border-top: 1px dashed var(--color-border-subtle);
  }

  /* Mobile Sticky COD Bar */
  .sticky-mobile-buy-bar {
    display: none;
  }

  @media (max-width: 767px) {
    .sticky-mobile-buy-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      position: fixed;
      bottom: 0;
      inset-inline-start: 0;
      inset-inline-end: 0;
      z-index: var(--z-header);
      padding: 0.75rem 1rem;
      background-color: rgba(255, 255, 255, 0.94);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-top: 1px solid var(--color-border-subtle);
      box-shadow: 0 -8px 24px rgba(var(--color-forest-rgb), 0.08);
    }

    .sticky-bar-info {
      flex: 1;
      min-width: 0;
    }

    .sticky-title {
      font-family: var(--font-heading);
    }

    .sticky-btn {
      min-height: 48px;
      padding-inline: 1rem;
      border-radius: var(--radius-full);
    }
  }
</style>

<!-- JSON-LD Structured Data Schema for Google Rich Snippets (Blueprint Section 11) -->
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | default: "زيت الأرغان المغربي النقي 100% — معصور على البارد (100 مل)" | json }},
  "image": [ {{ product.featured_media | image_url: width: 800 | default: "luxury-hero-skincare.jpg" | prepend: 'https:' | json }} ],
  "description": {{ product.description | strip_html | default: "زيت أرغان مغربي أصلي 100% معصور على البارد من منطقة سوس، خالي من المواد الكيميائية والعطور." | json }},
  "brand": { "@type": "Brand", "name": "NATURA Moroccan Natural Skincare" },
  "offers": {
    "@type": "Offer",
    "priceCurrency": "MAD",
    "price": "{{ product.price | money_without_currency | default: '199.00' }}",
    "itemCondition": "https://schema.org/NewCondition",
    "availability": "https://schema.org/InStock"
  }
}
</script>

{% schema %}
{
  "name": "تفاصيل المنتج الرئيسية",
  "settings": [],
  "blocks": [
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
