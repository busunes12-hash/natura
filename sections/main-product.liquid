{% comment %}
  Section 3.3 & 11: Main Product Detail Page with JSON-LD Structured Data Schema & Sticky Mobile COD Bar
{% endcomment %}
{{ 'component-forms.css' | asset_url | stylesheet_tag }}

<section class="main-product-section py-8" style="background-color: var(--color-bg-primary);">
  <div class="container">
    {% render 'breadcrumb' %}

    <div class="product-main-grid grid grid-cols-1 md:grid-cols-2 gap-12 mt-4" style="display: grid; gap: 3rem;">
      <!-- Column 1: Product Gallery -->
      <div class="product-gallery">
        <div class="main-image-wrapper rounded-lg shadow-md overflow-hidden bg-surface mb-4" style="aspect-ratio: 1/1; border-radius: var(--radius-lg);">
          {%- if product.featured_media -%}
            <img
              src="{{ product.featured_media | image_url: width: 800 }}"
              alt="{{ product.title | escape }}"
              class="w-full h-full object-cover"
              loading="eager"
              width="800"
              height="800"
            >
          {%- else -%}
            <div class="flex items-center justify-center h-full bg-cream text-forest text-6xl">
              {% render 'icon', name: 'leaf' %}
            </div>
          {%- endif -%}
        </div>

        {%- if product.media.size > 1 -%}
          <div class="product-thumbnails mb-6">
            {%- for media in product.media -%}
              <button
                type="button"
                class="thumbnail-btn {% if forloop.first %}is-active{% endif %}"
                data-image-src="{{ media | image_url: width: 800 }}"
                aria-label="عرض الصورة {{ forloop.index }}"
              >
                <img src="{{ media | image_url: width: 150 }}" alt="{{ media.alt | default: product.title | escape }}" width="72" height="72" loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <!-- Clinical Study Results Box -->
        {% render 'clinical-box' %}
      </div>

      <!-- Column 2: Product Info & COD Order Form -->
      <div class="product-info flex flex-col gap-6">
        <div class="tags-row flex items-center gap-2">
          <span class="badge-forest flex items-center gap-1.5">
            <span class="w-3.5 h-3.5 inline-flex items-center justify-center">{% render 'icon', name: 'leaf' %}</span>
            <span>عضوي 100%</span>
          </span>
          <span class="badge-terracotta flex items-center gap-1.5">
            <span class="w-3.5 h-3.5 inline-flex items-center justify-center">{% render 'icon', name: 'badge-check' %}</span>
            <span>مختبر طبياً</span>
          </span>
        </div>

        <h1 class="type-h1">{{ product.title | default: "سيروم فيتامين C العضوي بالنباتات المغربية" }}</h1>

        <div class="rating-row flex items-center gap-2 text-sm">
          <div class="stars flex">
            {%- for i in (1..5) -%}
              {% render 'icon', name: 'star' %}
            {%- endfor -%}
          </div>
          <span class="font-bold text-forest">4.9/5 (1,240 تقييم موثق)</span>
        </div>

        {% render 'price', product: product %}

        <!-- Stock Scarcity Urgency Badge Snippet -->
        {% render 'scarcity-badge', product: product %}

        {% form 'product', product, class: 'product-form flex flex-col gap-4' %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

          {%- if product.has_only_default_variant == false -%}
            <div class="variant-select-wrapper">
              <label class="font-bold text-sm mb-2 block">اختر السعة:</label>
              <div class="variant-pills">
                {%- for variant in product.variants -%}
                  <button
                    type="button"
                    class="variant-pill {% if variant.id == product.selected_or_first_available_variant.id %}is-active{% endif %}"
                    data-variant-id="{{ variant.id }}"
                  >
                    <span>{{ variant.title }}</span>
                    <span class="opacity-80">({{ variant.price | money_without_currency }} د.م.)</span>
                  </button>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}

          <div class="quantity-row flex items-center gap-4">
            <label class="font-bold text-sm">الكمية:</label>
            <quantity-input class="quantity-input">
              <button type="button" name="minus" class="quantity-btn" aria-label="تقليل الكمية">-</button>
              <input type="number" name="quantity" value="1" min="1" max="10" class="quantity-field" readonly aria-label="كمية المنتج">
              <button type="button" name="plus" class="quantity-btn" aria-label="زيادة الكمية">+</button>
            </quantity-input>
          </div>

          <button
            type="submit"
            name="add"
            class="btn-terracotta text-lg py-4 w-full shadow-lg flex items-center justify-center gap-2"
            data-quick-add="{{ product.selected_or_first_available_variant.id }}"
          >
            <span class="w-5 h-5 inline-flex items-center justify-center">{% render 'icon', name: 'truck' %}</span>
            <span>طلب الآن — الدفع عند الاستلام</span>
          </button>
        {% endform %}

        {% render 'trust-bar' %}

        <!-- Shopify OS 2.0 App Blocks Injection Point -->
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}
          {%- endcase -%}
        {%- endfor -%}

        <!-- Accordions -->
        <div class="product-accordions flex flex-col gap-3 mt-4">
          <details class="p-4 bg-surface rounded-md border" style="border-color: var(--color-border-subtle); border-radius: var(--radius-md);">
            <summary class="font-bold cursor-pointer select-none flex items-center gap-2" style="font-family: var(--font-heading);">
              <span class="w-4 h-4 text-forest inline-flex items-center justify-center">{% render 'icon', name: 'leaf' %}</span>
              <span>المكونات العضوية 100%</span>
            </summary>
            <p class="pt-3 text-sm text-muted">زيت الأرغان المغربي البكر، مستخلص فيتامين C النقي من الحمضيات، زيت التين الشوكي المعصور على البارد، وماء الورد البلدي.</p>
          </details>

          <details class="p-4 bg-surface rounded-md border" style="border-color: var(--color-border-subtle); border-radius: var(--radius-md);">
            <summary class="font-bold cursor-pointer select-none flex items-center gap-2" style="font-family: var(--font-heading);">
              <span class="w-4 h-4 text-forest inline-flex items-center justify-center">{% render 'icon', name: 'sparkle' %}</span>
              <span>طريقة الاستخدام الصحيحة</span>
            </summary>
            <p class="pt-3 text-sm text-muted">ضعي 3 إلى 4 قطرات على بشرة نظيفة وجافة صباحاً ومساءً، ثم دلكي بحركات دائرية لطيفة حتى الامتصاص التام.</p>
          </details>

          <details class="p-4 bg-surface rounded-md border" style="border-color: var(--color-border-subtle); border-radius: var(--radius-md);">
            <summary class="font-bold cursor-pointer select-none flex items-center gap-2" style="font-family: var(--font-heading);">
              <span class="w-4 h-4 text-forest inline-flex items-center justify-center">{% render 'icon', name: 'truck' %}</span>
              <span>سياسة الشحن والدفع بالمغرب</span>
            </summary>
            <p class="pt-3 text-sm text-muted">شحن سريع 24-48 ساعة لجميع مدن المغرب. الدفع نقداً عند استلام طلبكِ ومعاينته مع موزع الشحن.</p>
          </details>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Mobile Sticky COD Buy Bar -->
<div class="sticky-mobile-buy-bar fixed bottom-0 inset-x-0 z-40 p-3 bg-surface border-t shadow-lg flex items-center justify-between gap-3 md:hidden" style="position: fixed; bottom: 0; inset-inline-start: 0; inset-inline-end: 0; z-index: 400; background-color: var(--color-bg-surface); border-top: 1px solid var(--color-border-subtle); box-shadow: 0 -8px 24px rgba(0,0,0,0.06);">
  <div>
    <h4 class="font-bold text-xs line-clamp-1" style="font-family: var(--font-heading);">{{ product.title | default: "سيروم فيتامين C" }}</h4>
    <span class="font-bold text-forest text-sm">{{ product.price | default: 19900 | money_without_currency }} د.م.</span>
  </div>
  <button
    type="button"
    class="btn-terracotta text-sm py-2 px-4 whitespace-nowrap flex items-center gap-1.5"
    style="min-height: 42px;"
    data-quick-add="{{ product.selected_or_first_available_variant.id }}"
  >
    <span class="w-4 h-4 inline-flex items-center justify-center">{% render 'icon', name: 'truck' %}</span>
    <span>طلب الآن — COD</span>
  </button>
</div>

<!-- JSON-LD Structured Data Schema for Google Rich Snippets (Blueprint Section 11) -->
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | default: "سيروم فيتامين C العضوي" | json }},
  "image": [ {{ product.featured_media | image_url: width: 800 | default: "luxury-hero-skincare.jpg" | prepend: 'https:' | json }} ],
  "description": {{ product.description | strip_html | default: "سيروم مركز غني بمستخلص فيتامين C النقي وزيت الأرغان المغربي البكر." | json }},
  "brand": { "@type": "Brand", "name": "MATERIA Organic Skincare" },
  "offers": {
    "@type": "Offer",
    "priceCurrency": "MAD",
    "price": "{{ product.price | money_without_currency | default: '199.00' }}",
    "itemCondition": "https://schema.org/NewCondition",
    "availability": "https://schema.org/InStock"
  }
}
</script>

{% schema %}
{
  "name": "تفاصيل المنتج الرئيسية",
  "settings": [],
  "blocks": [
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
