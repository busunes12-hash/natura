{% comment %}
  Cookie consent bottom banner
  Phase 7 & 9: Tokenized colors and z-index toast token
{% endcomment %}
<div
  id="CookieConsentBanner"
  class="cookie-banner fixed bottom-4 inset-inline-start-4 inset-inline-end-4 md:inset-inline-start-auto md:inset-inline-end-4 p-4 rounded-lg shadow-lg border border-subtle-token flex items-center justify-between gap-4 max-w-lg bg-surface"
  style="z-index: var(--z-toast);"
  role="region"
  aria-label="إشعار الخصوصية والمطابقة"
>
  <p class="text-xs text-muted leading-relaxed">
    نحن نستخدم ملفات تعريف الارتباط (الكوكيز) لتحسين تجربة تسوقكِ وتخصيص العروض.
  </p>
  <button
    type="button"
    class="btn-primary text-xs py-2 px-4 whitespace-nowrap"
    onclick="document.getElementById('CookieConsentBanner').style.display = 'none'"
  >
    موافق
  </button>
</div>

{% schema %}
{
  "name": "إشعار ملفات الارتباط",
  "settings": []
}
{% endschema %}
