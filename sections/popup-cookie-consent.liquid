{% comment %}
  Cookie consent bottom banner
  Phase 7 & 9: Tokenized colors and z-index toast token
{% endcomment %}
<div
  id="CookieConsentBanner"
  class="cookie-banner fixed bottom-4 inset-inline-start-4 inset-inline-end-4 p-4 rounded-lg shadow-lg border border-subtle-token flex items-center justify-between gap-4 max-w-lg bg-surface"
  style="z-index: var(--z-toast); display: none;"
  role="region"
  aria-label="إشعار الخصوصية والمطابقة"
>
  <p class="text-xs text-muted leading-relaxed">
    نحن نستخدم ملفات تعريف الارتباط (الكوكيز) لتحسين تجربة تسوقكِ وتخصيص العروض.
  </p>
  <button
    type="button"
    class="btn-primary text-xs py-2 px-4 whitespace-nowrap"
    id="AcceptCookieBtn"
  >
    موافق
  </button>
</div>

<script>
  (function() {
    var banner = document.getElementById('CookieConsentBanner');
    var btn = document.getElementById('AcceptCookieBtn');
    if (!banner) return;
    try {
      if (localStorage.getItem('natura_cookie_consent') === 'true') {
        return;
      }
    } catch(e) {}
    banner.style.display = 'flex';
    if (btn) {
      btn.addEventListener('click', function() {
        banner.style.display = 'none';
        try {
          localStorage.setItem('natura_cookie_consent', 'true');
        } catch(e) {}
      });
    }
  })();
</script>

{% schema %}
{
  "name": "إشعار ملفات الارتباط",
  "settings": []
}
{% endschema %}
