{% comment %}
  Section 1: Announcement Bar — Auto-rotating 3-message cycle
{% endcomment %}

<div
  class="announcement-bar"
  style="background-color: var(--color-forest); color: var(--color-bg-primary);"
  role="banner"
  aria-label="إعلانات المتجر"
>
  <div class="container">
    <div class="announcement-track" id="AnnouncementTrack">

      <div class="announcement-slide is-active" role="status" aria-live="polite">
        <span class="announcement-icon">{% render 'icon', name: 'truck' %}</span>
        <span class="announcement-text">{{ section.settings.text_1 | default: 'توصيل سريع ومجاني في 24-48 ساعة داخل جميع مدن المغرب للطلبات فوق 200 د.م.' }}</span>
      </div>

      <div class="announcement-slide" aria-hidden="true">
        <span class="announcement-icon">{% render 'icon', name: 'shield' %}</span>
        <span class="announcement-text">{{ section.settings.text_2 | default: 'معاينة الشحنة مجاناً عند باب منزلكِ قبل الدفع — الدفع نقداً عند الاستلام 100%' }}</span>
      </div>

      <div class="announcement-slide" aria-hidden="true">
        <span class="announcement-icon">{% render 'icon', name: 'sparkle' %}</span>
        <span class="announcement-text">{{ section.settings.text_3 | default: 'زيوت مغربية نقية 100% بدون إضافات كيميائية | معاينة مجانية قبل الدفع' }}</span>
      </div>

    </div>
  </div>
</div>

<style>
  .announcement-bar {
    min-height: 40px;
    padding-block: 10px;
    overflow: hidden;
  }

  .announcement-bar .container {
    position: relative;
  }

  .announcement-track {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    height: 20px;
  }

  /* RTL-correct layout: flex row — icon appears at inline-start (right in RTL) */
  .announcement-slide {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    font-size: 0.875rem;
    font-weight: 600;
    font-family: var(--font-body);
    white-space: nowrap;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.5s ease, transform 0.5s ease;
    pointer-events: none;
    /* direction: ltr REMOVED — was breaking RTL icon placement */
  }

  .announcement-slide.is-active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .announcement-icon {
    width: 16px;
    height: 16px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    /* No transform: scaleX(-1) here — SVG truck/shield icons are directionally neutral */
  }

  .announcement-text {
    /* Inherits direction: rtl from html[dir=rtl] — no override needed */
    unicode-bidi: isolate;
  }

  @media (max-width: 480px) {
    .announcement-slide {
      font-size: 0.78rem;
      white-space: normal;
      text-align: center;
    }
    .announcement-track {
      height: auto;
      min-height: 20px;
    }
  }
</style>

<script>
  (function() {
    var slides = document.querySelectorAll('#AnnouncementTrack .announcement-slide');
    if (!slides || slides.length < 2) return;
    var current = 0;
    var interval = {{ section.settings.interval | default: 4000 }};
    setInterval(function() {
      slides[current].classList.remove('is-active');
      slides[current].setAttribute('aria-hidden', 'true');
      current = (current + 1) % slides.length;
      slides[current].classList.add('is-active');
      slides[current].removeAttribute('aria-hidden');
    }, interval);
  })();
</script>

{% schema %}
{
  "name": "شريط الإعلانات",
  "settings": [
    {
      "type": "text",
      "id": "text_1",
      "label": "الإعلان الأول",
      "default": "توصيل سريع ومجاني في 24-48 ساعة داخل جميع مدن المغرب للطلبات فوق 200 د.م."
    },
    {
      "type": "text",
      "id": "text_2",
      "label": "الإعلان الثاني",
      "default": "معاينة الشحنة مجاناً عند باب منزلكِ قبل الدفع — الدفع نقداً عند الاستلام 100%"
    },
    {
      "type": "text",
      "id": "text_3",
      "label": "الإعلان الثالث",
      "default": "زيوت مغربية نقية 100% بدون إضافات كيميائية | معاينة مجانية قبل الدفع"
    },
    {
      "type": "range",
      "id": "interval",
      "min": 3000,
      "max": 8000,
      "step": 500,
      "default": 4000,
      "label": "سرعة التبديل (مللي ثانية)"
    }
  ]
}
{% endschema %}
