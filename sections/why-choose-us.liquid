{% comment %}
  Section 7: Why Choose Us — USP Pillars
  — No emojis in headings
  — Schema-controlled (all text editable)
  — 3-column on desktop, 1-column on mobile
{% endcomment %}

<section class="why-choose-us py-16 reveal-on-scroll" style="background-color: var(--color-bg-secondary);">
  <div class="container">
    <div class="section-header">
      <span class="badge-terracotta mb-4" style="display: inline-flex;">{{ section.settings.badge | default: 'لماذا تختار عائلات المغرب ناتورا؟' }}</span>
      <h2 class="type-h2">{{ section.settings.title | default: '3 أسباب تجعل ناتورا الاختيار الأول والآمن لكل بيت مغربي' }}</h2>
      <p class="section-subtitle">{{ section.settings.subtitle | default: 'نوفر لكِ ولأسرتكِ مستحضرات طبيعية نقية بأسعار عادلة وتوصيل موثوق حتى باب المنزل' }}</p>
    </div>

    <div class="pillars-grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'pillar' -%}
            <div class="pillar-card text-center" {{ block.shopify_attributes }}>
              <div class="pillar-icon-wrapper">
                {%- assign icon_name = block.settings.icon | default: 'leaf' -%}
              {% render 'icon', name: icon_name %}
              </div>
              <h3 class="font-bold mb-2" style="font-family: var(--font-heading); font-size: 1.2rem;">{{ block.settings.title | default: 'ميزة رئيسية' }}</h3>
              <p class="text-muted text-sm leading-relaxed">{{ block.settings.description | default: 'وصف الميزة الرئيسية لمنتجاتنا الطبيعية الصادقة.' }}</p>
            </div>
        {%- endcase -%}
      {%- else -%}
        <!-- Default 3 pillars -->
        <div class="pillar-card text-center">
          <div class="pillar-icon-wrapper">{% render 'icon', name: 'leaf' %}</div>
          <h3 class="font-bold mb-2" style="font-family: var(--font-heading); font-size: 1.2rem;">مكونات حقيقية 100% بدون تخفيف</h3>
          <p class="text-muted text-sm leading-relaxed">نضمن لكِ عصارة أولى نقية لزيوت الأرغان والتين الشوكي المستخرجة مباشرة من معاصر سوس والأطلس. لا نستخدم الزيوت الرخيصة المخففة أو العطور الاصطناعية.</p>
        </div>
        <div class="pillar-card text-center">
          <div class="pillar-icon-wrapper">{% render 'icon', name: 'shield' %}</div>
          <h3 class="font-bold mb-2" style="font-family: var(--font-heading); font-size: 1.2rem;">تركيبات لطيفة مخصصة للاستعمال اليومي</h3>
          <p class="text-muted text-sm leading-relaxed">صُممت منتجاتنا بمكونات نباتية مهدئة تناسب جميع أنواع البشرة والشعر، بما في ذلك البشرة الحساسة للأطفال والكبار، لتكون الخيار الآمن اليومي لكل العائلة.</p>
        </div>
        <div class="pillar-card text-center">
          <div class="pillar-icon-wrapper">{% render 'icon', name: 'truck' %}</div>
          <h3 class="font-bold mb-2" style="font-family: var(--font-heading); font-size: 1.2rem;">أسعار عادلة وتوصيل آمن لباب البيت</h3>
          <p class="text-muted text-sm leading-relaxed">نؤمن بأن العناية الطبيعية حق لكل بيت. نوفر منتجاتنا بأسعار مناسبة مع خدمة معاينة الشحنة قبل الدفع نقداً عند الاستلام لضمان راحة بالكِ التامة.</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .pillar-card {
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }
  .pillar-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }
  .pillar-icon-wrapper {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(45, 95, 62, 0.1);
    color: var(--color-forest);
    margin-bottom: 1.25rem;
    flex-shrink: 0;
  }
  .pillar-icon-wrapper svg {
    width: 32px;
    height: 32px;
  }
  @media (max-width: 1024px) {
    .pillars-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .pillars-grid { grid-template-columns: 1fr; }
  }
</style>

{% schema %}
{
  "name": "لماذا تميزت منتجاتنا",
  "settings": [
    { "type": "text", "id": "badge", "label": "نص البادج", "default": "لماذا تختار عائلات المغرب ناتورا؟" },
    { "type": "text", "id": "title", "label": "العنوان", "default": "3 أسباب تجعل ناتورا الاختيار الأول والآمن لكل بيت مغربي" },
    { "type": "textarea", "id": "subtitle", "label": "الوصف", "default": "نوفر لكِ ولأسرتكِ مستحضرات طبيعية نقية بأسعار عادلة وتوصيل موثوق حتى باب المنزل" }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "دعامة",
      "settings": [
        { "type": "select", "id": "icon", "label": "الأيقونة", "default": "leaf", "options": [
          { "value": "leaf", "label": "ورقة" },
          { "value": "flask", "label": "قارورة" },
          { "value": "shield", "label": "درع" },
          { "value": "truck", "label": "شاحنة" },
          { "value": "star", "label": "نجمة" },
          { "value": "sparkle", "label": "بريق" }
        ]},
        { "type": "text", "id": "title", "label": "العنوان", "default": "ميزة رئيسية" },
        { "type": "textarea", "id": "description", "label": "الوصف", "default": "وصف الميزة الرئيسية لمنتجاتنا الطبيعية الفاخرة." }
      ]
    }
  ],
  "presets": [{ "name": "لماذا تميزت منتجاتنا" }]
}
{% endschema %}
