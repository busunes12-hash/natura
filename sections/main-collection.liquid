{% comment %}
  Section 3.2: Collection Page Section
{% endcomment %}
<section class="main-collection-section py-8" style="background-color: var(--color-bg-primary);">
  <div class="container">
    {% render 'breadcrumb' %}

    <div class="collection-header flex flex-col md:flex-row items-center justify-between gap-4 mb-8">
      <div>
        <h1 class="type-h1">{{ collection.title | default: "جميع المنتجات الطبيعية" }}</h1>
        {%- if collection.description != blank -%}
          <p class="text-muted text-sm mt-1">{{ collection.description }}</p>
        {%- endif -%}
      </div>

      <div class="collection-controls flex flex-wrap items-center gap-4">
        {%- if collection.filters.size > 0 -%}
          <div class="filters-summary flex items-center gap-2">
            <span class="text-sm font-bold">التصفية:</span>
            {%- for filter in collection.filters -%}
              <span class="badge-forest text-xs">{{ filter.label }}</span>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="sort-wrapper flex items-center gap-2">
          <label class="text-sm font-bold whitespace-nowrap">الترتيب حسب:</label>
          <select class="form-select text-sm py-2" style="width: auto;" onchange="location.href = this.value">
            <option value="?sort_by=manual" {% if collection.sort_by == 'manual' %}selected{% endif %}>المميز</option>
            <option value="?sort_by=best-selling" {% if collection.sort_by == 'best-selling' %}selected{% endif %}>الأكثر مبيعاً</option>
            <option value="?sort_by=price-ascending" {% if collection.sort_by == 'price-ascending' %}selected{% endif %}>السعر: من الأقل للأعلى</option>
            <option value="?sort_by=price-descending" {% if collection.sort_by == 'price-descending' %}selected{% endif %}>السعر: من الأعلى للأقل</option>
          </select>
        </div>
      </div>
    </div>

    {%- paginate collection.products by 12 -%}
      {%- if collection.products.size > 0 -%}
        <div class="products-grid mb-8">
          {%- for product in collection.products -%}
            {% render 'product-card', product: product %}
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="collection-empty text-center py-16 bg-surface rounded-lg border p-8 my-8" style="border-color: var(--color-border-subtle); border-radius: var(--radius-lg);">
          <span class="w-12 h-12 text-forest mb-4 inline-flex items-center justify-center">{% render 'icon', name: 'leaf' %}</span>
          <h3 class="type-h2 mb-2" style="font-size: 1.5rem;">لا توجد منتجات مطابقة حالياً</h3>
          <p class="text-muted text-sm mb-6">جربي تغيير خيارات التصفية أو تصفح باقي مجموعاتنا الفاخرة.</p>
          <a href="/collections/all" class="btn-primary inline-flex items-center gap-2">
            <span>عرض جميع المنتجات</span>
          </a>
        </div>
      {%- endif -%}

      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>

<style>
  .products-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }
  @media (max-width: 1024px) {
    .products-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 640px) {
    .products-grid {
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 0.75rem;
    }
  }
</style>

{% schema %}
{
  "name": "صفحة المجموعة الرئيسية",
  "settings": []
}
{% endschema %}
