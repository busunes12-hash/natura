{% comment %}
  Section 4: Ingredients / Pill Capsule Trust Bar
  Container: Pill capsule shape (rounded-full) on desktop with 1px solid var(--color-border-subtle) border.
  Icons: 28x28px stroke SVGs.
{% endcomment %}
<section class="ingredients-trust-bar py-8" style="background-color: var(--color-bg-primary);">
  <div class="container">
    <div class="pill-container flex flex-wrap items-center justify-between gap-6 py-5 px-8 rounded-full border shadow-sm" style="border: 1px solid var(--color-border-subtle); background-color: var(--color-bg-surface);">
      
      <div class="pill-item flex items-center gap-3">
        <span class="pill-icon text-forest flex items-center justify-center rounded-full" style="width: 40px; height: 40px; background-color: rgba(45, 95, 62, 0.08);">
          {% render 'icon', name: 'truck' %}
        </span>
        <div>
          <h4 class="font-bold text-sm" style="font-size: 0.95rem; color: var(--color-charcoal-dark);">🇲🇦 الدفع عند الاستلام</h4>
          <p class="text-xs text-muted" style="font-size: 0.825rem; color: var(--color-text-muted);">توصيل آمن لجميع المدن</p>
        </div>
      </div>

      <div class="pill-item flex items-center gap-3">
        <span class="pill-icon text-forest flex items-center justify-center rounded-full" style="width: 40px; height: 40px; background-color: rgba(45, 95, 62, 0.08);">
          {% render 'icon', name: 'flask' %}
        </span>
        <div>
          <h4 class="font-bold text-sm" style="font-size: 0.95rem; color: var(--color-charcoal-dark);">🔬 مختبر جلدياً</h4>
          <p class="text-xs text-muted" style="font-size: 0.825rem; color: var(--color-text-muted);">آمن 100% للبشرة الحساسة</p>
        </div>
      </div>

      <div class="pill-item flex items-center gap-3">
        <span class="pill-icon text-forest flex items-center justify-center rounded-full" style="width: 40px; height: 40px; background-color: rgba(45, 95, 62, 0.08);">
          {% render 'icon', name: 'shield' %}
        </span>
        <div>
          <h4 class="font-bold text-sm" style="font-size: 0.95rem; color: var(--color-charcoal-dark);">🚚 شحن سريع 24-48h</h4>
          <p class="text-xs text-muted" style="font-size: 0.825rem; color: var(--color-text-muted);">خدمة توصيل فورية</p>
        </div>
      </div>

      <div class="pill-item flex items-center gap-3">
        <span class="pill-icon text-forest flex items-center justify-center rounded-full" style="width: 40px; height: 40px; background-color: rgba(45, 95, 62, 0.08);">
          {% render 'icon', name: 'leaf' %}
        </span>
        <div>
          <h4 class="font-bold text-sm" style="font-size: 0.95rem; color: var(--color-charcoal-dark);">🌿 مكونات عضوية 100%</h4>
          <p class="text-xs text-muted" style="font-size: 0.825rem; color: var(--color-text-muted);">خالية من المواد الكيميائية</p>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  @media (max-width: 768px) {
    .pill-container {
      border-radius: var(--radius-lg) !important;
      padding: 1.25rem !important;
    }
  }
</style>

{% schema %}
{
  "name": "شريط الثقة والمكونات",
  "settings": []
}
{% endschema %}
