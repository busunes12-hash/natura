{% comment %}
  Section 3.4: AJAX Slide-Out Cart Drawer with CRO Inspection Guarantee & One-Click Upsell Widget
{% endcomment %}
{{ 'component-drawer.css' | asset_url | stylesheet_tag }}

<drawer-component id="CartDrawer" class="drawer-component">
  <div class="drawer-overlay"></div>

  <div class="drawer-content">
    <div class="drawer-header">
      <h3 class="drawer-title flex items-center gap-2">
        <span class="w-5 h-5 text-forest inline-flex items-center justify-center">{% render 'icon', name: 'cart' %}</span>
        <span>سلة التسوق</span>
      </h3>
      <button type="button" class="drawer-close" data-drawer-close aria-label="إغلاق السلة">
        {% render 'icon', name: 'close' %}
      </button>
    </div>

    <!-- Free Shipping Progress Bar (200 MAD Threshold) -->
    {%- assign free_shipping_threshold = settings.free_shipping_threshold | default: 200 | times: 100 -%}
    {%- assign cart_total = cart.total_price -%}
    {%- assign progress_percentage = cart_total | times: 100 | divided_by: free_shipping_threshold -%}
    {%- if progress_percentage > 100 -%}{%- assign progress_percentage = 100 -%}{%- endif -%}

    <div class="free-shipping-bar text-xs font-bold text-center">
      {%- if cart_total >= free_shipping_threshold -%}
        <span class="text-forest flex items-center justify-center gap-1.5">
          <span class="w-4 h-4 inline-flex items-center justify-center">{% render 'icon', name: 'sparkle' %}</span>
          <span>مبروك! لقد حصلتِ على توصيل ملكي مجاني وتغليف هدايا فاخر!</span>
        </span>
      {%- else -%}
        {%- assign needed = free_shipping_threshold | minus: cart_total -%}
        <span>🚚 باقي لكِ <strong class="text-terracotta">{{ needed | money_without_currency }} د.م.</strong> فقط لفتح الشحن السريع المجاني وتغليف الهدايا الملكي!</span>
      {%- endif -%}
      <div class="progress-track">
        <div class="progress-fill" style="width: {{ progress_percentage }}%;"></div>
      </div>
    </div>

    <!-- Drawer Body -->
    <div class="drawer-body" id="CartDrawerContent">
      {%- if cart.item_count > 0 -%}
        <div class="cart-items-list flex flex-col gap-4">
          {%- for item in cart.items -%}
            <div class="cart-item flex gap-4 p-3 bg-surface rounded-md border" style="border-color: var(--color-border-subtle);">
              <div class="cart-item__image w-16 h-16 rounded overflow-hidden flex-shrink-0 bg-cream" style="width: 64px; height: 64px;">
                {%- if item.image -%}
                  <img src="{{ item.image | image_url: width: 120 }}" alt="{{ item.title | escape }}" class="w-full h-full object-cover" width="64" height="64">
                {%- else -%}
                  <div class="flex items-center justify-center h-full text-forest">
                    {% render 'icon', name: 'leaf' %}
                  </div>
                {%- endif -%}
              </div>

              <div class="cart-item__details flex-grow flex flex-col justify-between">
                <div class="flex items-start justify-between">
                  <h4 class="font-bold text-sm leading-tight">{{ item.product.title }}</h4>
                  <button
                    type="button"
                    class="text-xs text-muted hover:text-terracotta"
                    data-cart-remove="{{ item.key }}"
                    aria-label="حذف المنتج من السلة"
                  >
                    حذف
                  </button>
                </div>

                <div class="flex items-center justify-between mt-2">
                  <quantity-input class="quantity-input" style="scale: 0.85; transform-origin: right center;">
                    <button type="button" name="minus" class="quantity-btn" onclick="CartManager.changeQuantity('{{ item.key }}', {{ item.quantity | minus: 1 }})">-</button>
                    <input type="number" value="{{ item.quantity }}" readonly class="quantity-field" aria-label="الكمية">
                    <button type="button" name="plus" class="quantity-btn" onclick="CartManager.changeQuantity('{{ item.key }}', {{ item.quantity | plus: 1 }})">+</button>
                  </quantity-input>

                  <span class="font-bold text-forest text-sm">
                    {{ item.final_line_price | money_without_currency }} د.م.
                  </span>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>

        <!-- High-AOV One-Click Complementary Upsell Widget -->
        {%- if cart_total < free_shipping_threshold -%}
          <div class="upsell-widget p-3 mt-4 rounded-md border bg-cream" style="background-color: var(--color-bg-secondary); border-color: var(--color-border-subtle);">
            <div class="flex items-center justify-between gap-2">
              <div class="flex items-center gap-2">
                <span class="w-5 h-5 text-forest flex-shrink-0 inline-flex items-center justify-center">{% render 'icon', name: 'sparkle' %}</span>
                <div>
                  <h5 class="font-bold text-xs">✨ كملي روتينكِ: إكسير ماء الورد المقطر (50ml)</h5>
                  <span class="text-xs text-forest font-bold">+49 د.م. فقط (واكسري حد الشحن المجاني فوراً)</span>
                </div>
              </div>
              <button
                type="button"
                class="btn-primary text-xs py-1 px-3 flex items-center gap-1"
                style="min-height: 36px;"
                onclick="CartManager.addItem('{{ all_products['rose-water'].selected_or_first_available_variant.id | default: '1' }}', 1, this)"
              >
                <span>+ إضافة</span>
              </button>
            </div>
          </div>
        {%- endif -%}

      {%- else -%}
        <div class="cart-empty flex flex-col items-center justify-center text-center py-12">
          <span class="w-12 h-12 text-forest mb-3 inline-flex items-center justify-center">{% render 'icon', name: 'cart' %}</span>
          <h4 class="font-bold text-lg mb-2">🌸 سلتكِ تنتظر لمسة جمال!</h4>
          <p class="text-xs text-muted mb-6">أضيفي منتجكِ المفضل الآن واحصلي على عينتين مجانيتين مع طلبكِ الأول.</p>
          <a href="/collections/all" class="btn-primary text-sm inline-flex items-center gap-2" data-drawer-close>
            <span>🌿 تصفحي المنتجات الأكثر مبيعاً</span>
          </a>
        </div>
      {%- endif -%}
    </div>

    <!-- Drawer Footer -->
    <div class="drawer-footer">
      <div class="cod-banner p-3 rounded-md bg-cream text-center text-xs font-bold text-forest mb-2 flex items-center justify-center gap-1.5" style="background-color: var(--color-bg-secondary);">
        <span class="w-4 h-4 inline-flex items-center justify-center">{% render 'icon', name: 'truck' %}</span>
        <span>معاينة الشحنة مجانية عند باب منزلكِ قبل دفع سنتيم واحد للموزع</span>
      </div>

      <div class="text-center text-xs text-muted mb-4 flex items-center justify-center gap-1">
        <span class="w-3.5 h-3.5 inline-flex items-center justify-center">{% render 'icon', name: 'shield' %}</span>
        <span>ضمان إشراقة 30 يوماً — استرجاع كامل المبلغ بدون مخاطرة</span>
      </div>

      <div class="subtotal-row flex items-center justify-between mb-4 font-bold text-lg">
        <span>المجموع الفرعي:</span>
        <span class="text-forest">{{ cart.total_price | money_without_currency }} د.م.</span>
      </div>

      <form action="{{ routes.cart_url }}" method="post">
        <button
          type="submit"
          name="checkout"
          class="btn-terracotta w-full text-center text-base py-4 flex items-center justify-center gap-2"
          {% if cart.item_count == 0 %}disabled style="opacity: 0.5; cursor: not-allowed;"{% endif %}
        >
          <span class="w-5 h-5 inline-flex items-center justify-center">{% render 'icon', name: 'lock' %}</span>
          <span>🔒 تأكيد الطلب وحجز الشحنة — الدفع نقداً عند الاستلام</span>
        </button>
      </form>
    </div>
  </div>
</drawer-component>

{% schema %}
{
  "name": "سلة التسوق المنزلقة",
  "settings": [
    {
      "type": "product",
      "id": "upsell_product",
      "label": "منتج العرض الإضافي (Upsell Product)"
    }
  ]
}
{% endschema %}
