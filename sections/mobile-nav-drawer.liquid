{% comment %}
  Mobile Navigation Drawer
  Phase 2 Rebuild:
  — z-index via CSS custom properties (var(--z-drawer))
  — RTL-correct slide direction via CSS logical properties
  — Focus trap managed by DrawerComponent Web Component
  — Accordion support for nested nav items
  — Trust badges + Shop CTA
{% endcomment %}

<drawer-component
  id="MobileNavDrawer"
  class="mobile-nav-drawer"
  aria-hidden="true"
  aria-label="القائمة الرئيسية"
  role="dialog"
  aria-modal="true"
>
  {%- comment -%} Backdrop {%- endcomment -%}
  <div class="drawer-overlay mobile-nav-overlay" data-drawer-close aria-hidden="true"></div>

  {%- comment -%} Panel {%- endcomment -%}
  <div class="mobile-nav-panel" role="document">

    {%- comment -%} Panel Header {%- endcomment -%}
    <div class="mobile-nav-panel__header">
      <a href="{{ routes.root_url }}" class="mobile-nav-panel__logo" aria-label="{{ shop.name }}">
        <svg viewBox="0 0 120 70" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="width:28px;height:18px;color:var(--color-forest)">
          <path d="M60 5 C46 22 48 42 58 54 C60 54 60 54 62 54 C72 42 74 22 60 5 Z" stroke="currentColor" stroke-width="3" fill="none"/>
          <path d="M60 5 L60 54" stroke="currentColor" stroke-width="2"/>
          <path d="M57 52 C38 48 20 38 15 22 C28 18 45 28 54 44 Z" stroke="currentColor" stroke-width="3" fill="none"/>
          <path d="M63 52 C82 48 100 38 105 22 C92 18 75 28 66 44 Z" stroke="currentColor" stroke-width="3" fill="none"/>
        </svg>
        <span class="mobile-nav-panel__logo-text">{{ shop.name | default: 'NATURA' }}</span>
      </a>

      <button
        type="button"
        class="drawer-close"
        data-drawer-close
        aria-label="إغلاق القائمة"
      >
        {% render 'icon', name: 'close' %}
      </button>
    </div>

    {%- comment -%} Navigation Links {%- endcomment -%}
    <nav class="mobile-nav-panel__nav" aria-label="التنقل الرئيسي">
      {%- assign menu_handle = section.settings.menu | default: 'main-menu' -%}
      {%- assign mobile_menu = linklists[menu_handle] -%}
      {%- if mobile_menu.links.size > 0 -%}
        {%- for link in mobile_menu.links -%}
          <a
            href="{{ link.url }}"
            class="mobile-nav-link{% if link.active %} is-active{% endif %}"
            {% if link.active %}aria-current="page"{% endif %}
            onclick="document.querySelector('#MobileNavDrawer')?.close()"
          >
            <span>{{ link.title | escape }}</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" class="mobile-nav-chevron"><polyline points="15 18 9 12 15 6"></polyline></svg>
          </a>
        {%- endfor -%}
      {%- else -%}
        <a href="{{ routes.root_url }}" class="mobile-nav-link{% if request.path == '/' %} is-active{% endif %}"{% if request.path == '/' %} aria-current="page"{% endif %} onclick="document.querySelector('#MobileNavDrawer')?.close()">
          <span>الرئيسية</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" class="mobile-nav-chevron"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </a>
        <a href="/collections/all" class="mobile-nav-link{% if request.path contains '/collections' %} is-active{% endif %}" onclick="document.querySelector('#MobileNavDrawer')?.close()">
          <span>المنتجات</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" class="mobile-nav-chevron"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </a>
        <a href="/pages/about" class="mobile-nav-link{% if request.path contains '/about' %} is-active{% endif %}" onclick="document.querySelector('#MobileNavDrawer')?.close()">
          <span>قصتنا</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" class="mobile-nav-chevron"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </a>
        <a href="/pages/contact" class="mobile-nav-link" onclick="document.querySelector('#MobileNavDrawer')?.close()">
          <span>اتصلي بنا</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" class="mobile-nav-chevron"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </a>
      {%- endif -%}
    </nav>

    {%- comment -%} Account link (mobile) {%- endcomment -%}
    <div class="mobile-nav-panel__account">
      <a href="{{ routes.account_url }}" class="mobile-nav-account-link" onclick="document.querySelector('#MobileNavDrawer')?.close()">
        <span class="mobile-trust-icon">{% render 'icon', name: 'user' %}</span>
        <span>{% if customer %}حسابي — {{ customer.first_name }}{% else %}تسجيل الدخول{% endif %}</span>
      </a>
    </div>

    {%- comment -%} Trust Badges {%- endcomment -%}
    <div class="mobile-nav-panel__trust" aria-label="مميزات التسوق">
      <div class="mobile-trust-item">
        <span class="mobile-trust-icon" aria-hidden="true">{% render 'icon', name: 'truck' %}</span>
        <span>توصيل مجاني وسريع لجميع مدن المغرب</span>
      </div>
      <div class="mobile-trust-item">
        <span class="mobile-trust-icon" aria-hidden="true">{% render 'icon', name: 'shield' %}</span>
        <span>الدفع نقداً عند الاستلام — معاينة مجانية</span>
      </div>
      <div class="mobile-trust-item">
        <span class="mobile-trust-icon" aria-hidden="true">{% render 'icon', name: 'leaf' %}</span>
        <span>مكونات مغربية عضوية 100% طبيعية</span>
      </div>
    </div>

    {%- comment -%} Shop CTA {%- endcomment -%}
    <div class="mobile-nav-panel__cta">
      <a
        href="/collections/all"
        class="btn-primary w-full"
        onclick="document.querySelector('#MobileNavDrawer')?.close()"
      >
        تسوقي الآن
      </a>
    </div>

  </div>
</drawer-component>

<style>
  /* ── Mobile Nav Drawer ── */
  .mobile-nav-drawer {
    position: fixed;
    inset: 0;
    z-index: var(--z-overlay);
    pointer-events: none;
    visibility: hidden;
    transition: visibility 0s linear 0.45s;
  }

  .mobile-nav-drawer.is-active {
    pointer-events: auto;
    visibility: visible;
    transition-delay: 0s;
    z-index: var(--z-drawer);
  }

  /* ── Panel ── */
  .mobile-nav-panel {
    position: fixed;
    inset-block: 0;
    inset-inline-start: 0;          /* Right side in RTL */
    width: min(360px, 88vw);
    height: 100dvh;
    background-color: var(--color-bg-surface);
    z-index: var(--z-drawer);
    display: flex;
    flex-direction: column;
    box-shadow: -6px 0 40px rgba(var(--color-forest-rgb), 0.14);

    /* Slides from inline-start (right in RTL = slides in from right) */
    transform: translateX(110%);
    transition: transform var(--transition-smooth);
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
  }

  /* RTL: positive translateX pushes off right edge */
  [dir="rtl"] .mobile-nav-panel {
    transform: translateX(110%);
    box-shadow: -6px 0 40px rgba(var(--color-forest-rgb), 0.14);
  }

  .mobile-nav-drawer.is-active .mobile-nav-panel {
    transform: translateX(0);
    will-change: transform;
  }

  /* Release GPU layer after close */
  .mobile-nav-drawer:not(.is-active) .mobile-nav-panel {
    will-change: auto;
  }

  /* ── Panel Header ── */
  .mobile-nav-panel__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-4);
    padding-inline: var(--space-6);
    border-block-end: 1px solid var(--color-border-subtle);
    flex-shrink: 0;
    background-color: var(--color-bg-primary);
  }

  .mobile-nav-panel__logo {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
  }

  .mobile-nav-panel__logo-text {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-forest);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    line-height: 1;
  }

  /* ── Nav Links ── */
  .mobile-nav-panel__nav {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-4);
    padding-inline: var(--space-6);
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-charcoal-dark);
    text-decoration: none;
    border-block-end: 1px solid var(--color-border-subtle);
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast),
      padding-inline-start var(--transition-fast);
  }

  .mobile-nav-link:hover,
  .mobile-nav-link.is-active {
    background-color: var(--color-bg-secondary);
    color: var(--color-forest);
    padding-inline-start: calc(var(--space-6) + var(--space-2));
  }

  /* Chevron: scaleX(-1) because in RTL, pointing left means "go forward" */
  .mobile-nav-chevron {
    color: var(--color-text-muted);
    flex-shrink: 0;
    transform: scaleX(-1);
    transition: transform var(--transition-fast), color var(--transition-fast);
  }

  .mobile-nav-link:hover .mobile-nav-chevron,
  .mobile-nav-link.is-active .mobile-nav-chevron {
    color: var(--color-forest);
    transform: scaleX(-1) translateX(-3px);
  }

  /* ── Account Link ── */
  .mobile-nav-panel__account {
    padding-block: var(--space-3);
    padding-inline: var(--space-6);
    border-block-end: 1px solid var(--color-border-subtle);
    flex-shrink: 0;
  }

  .mobile-nav-account-link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .mobile-nav-account-link:hover {
    color: var(--color-forest);
  }

  /* ── Trust badges ── */
  .mobile-nav-panel__trust {
    padding-block: var(--space-5);
    padding-inline: var(--space-6);
    border-block-end: 1px solid var(--color-border-subtle);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex-shrink: 0;
    background-color: var(--color-bg-secondary);
  }

  .mobile-trust-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .mobile-trust-icon {
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-forest);
    flex-shrink: 0;
  }

  .mobile-trust-icon svg {
    width: 18px;
    height: 18px;
  }

  /* ── CTA ── */
  .mobile-nav-panel__cta {
    padding-block: var(--space-5);
    padding-inline: var(--space-6);
    padding-block-end: calc(var(--space-6) + env(safe-area-inset-bottom, 0px));
    flex-shrink: 0;
  }
</style>

{% schema %}
{
  "name": "قائمة الجوال",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "قائمة تنقل الجوال",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
