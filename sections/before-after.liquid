{% comment %}
  Section 9: Before & After Comparison Slider
  — Fully functional drag/touch slider via JS
  — Schema-controlled (merchant can edit all text from Customizer)
  — Shows styled placeholders if no photos uploaded
{% endcomment %}
{{ 'section-before-after.css' | asset_url | stylesheet_tag }}

<section class="before-after-section py-16 reveal-on-scroll" id="before-after">
  <div class="container">
    <div class="section-header">
      <span class="badge-forest mb-4" style="display: inline-flex;">{{ section.settings.badge | default: 'نتائج حقيقية' }}</span>
      <h2 class="type-h2">{{ section.settings.title | default: 'تحول ملحوظ خلال 30 يوماً' }}</h2>
      <p class="section-subtitle">{{ section.settings.subtitle | default: 'اسحبي الشريط للمقارنة بين البشرة قبل وبعد استعمال سيروم فيتامين C العضوي' }}</p>
    </div>

    <div class="before-after-container" id="BeforeAfterSlider" aria-label="مقارنة قبل وبعد" role="img">

      <!-- BEFORE panel -->
      <div class="ba-image ba-image--before">
        {%- if section.settings.image_before != blank -%}
          <img
            src="{{ section.settings.image_before | image_url: width: 820, format: 'webp' }}"
            alt="{{ section.settings.before_label | default: 'قبل' }}"
            loading="lazy"
            width="820"
            height="461"
            style="width:100%;height:100%;object-fit:cover;"
          >
        {%- else -%}
          <div class="ba-placeholder-content">
            <div class="ba-placeholder-icon" style="color: #a08060;">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M6 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/></svg>
            </div>
            <h4 class="ba-placeholder-title" style="color: #6b4c2a;">{{ section.settings.before_label | default: 'قبل الاستعمال' }}</h4>
            <p class="ba-placeholder-sub" style="color: #8c6844;">{{ section.settings.before_sub | default: 'بشرة مجهدة ودون إشراق' }}</p>
          </div>
        {%- endif -%}
      </div>

      <!-- AFTER panel -->
      <div class="ba-image ba-image--after" id="BaAfterPanel">
        {%- if section.settings.image_after != blank -%}
          <img
            src="{{ section.settings.image_after | image_url: width: 820, format: 'webp' }}"
            alt="{{ section.settings.after_label | default: 'بعد' }}"
            loading="lazy"
            width="820"
            height="461"
            style="width:100%;height:100%;object-fit:cover;"
          >
        {%- else -%}
          <div class="ba-placeholder-content">
            <div class="ba-placeholder-icon" style="color: var(--color-bg-secondary);">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
            </div>
            <h4 class="ba-placeholder-title" style="color: var(--color-bg-primary);">{{ section.settings.after_label | default: 'بعد 30 يوماً' }}</h4>
            <p class="ba-placeholder-sub" style="color: rgba(255,248,231,0.8);">{{ section.settings.after_sub | default: 'نضارة فائقة وتوحيد لون البشرة' }}</p>
          </div>
        {%- endif -%}
      </div>

      <!-- Divider + Handle -->
      <div class="ba-divider" id="BaDivider">
        <div class="ba-handle-circle">
          <div class="ba-handle-arrows">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><polyline points="9 6 15 12 9 18"></polyline></svg>
          </div>
        </div>
      </div>

      <!-- Labels -->
      <span class="ba-label ba-label--before" aria-hidden="true">{{ section.settings.before_label | default: 'قبل' }}</span>
      <span class="ba-label ba-label--after" aria-hidden="true">{{ section.settings.after_label | default: 'بعد' }}</span>

      <!-- Drag target -->
      <div class="ba-drag-target" id="BaDragTarget" aria-hidden="true"></div>
    </div>

    {%- if section.settings.show_stats -%}
    <div class="ba-stats">
      <div class="ba-stat">
        <span class="ba-stat__number">{{ section.settings.stat_1_number | default: '93%' }}</span>
        <span class="ba-stat__label">{{ section.settings.stat_1_label | default: 'لاحظن تحسناً في نضارة البشرة' }}</span>
      </div>
      <div class="ba-stat">
        <span class="ba-stat__number">{{ section.settings.stat_2_number | default: '30' }}</span>
        <span class="ba-stat__label">{{ section.settings.stat_2_label | default: 'يوماً للحصول على نتيجة واضحة' }}</span>
      </div>
      <div class="ba-stat">
        <span class="ba-stat__number">{{ section.settings.stat_3_number | default: '+10K' }}</span>
        <span class="ba-stat__label">{{ section.settings.stat_3_label | default: 'عميلة سعيدة بالنتيجة' }}</span>
      </div>
    </div>
    {%- endif -%}

  </div>
</section>

<style>
  .ba-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 2.5rem;
    text-align: center;
  }
  .ba-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }
  .ba-stat__number {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    color: var(--color-forest);
    line-height: 1;
  }
  .ba-stat__label {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    max-width: 180px;
    line-height: 1.5;
  }
  @media (max-width: 640px) {
    .ba-stats { grid-template-columns: 1fr; gap: 1.25rem; }
  }
</style>

<script>
  (function() {
    var container = document.getElementById('BeforeAfterSlider');
    var afterPanel = document.getElementById('BaAfterPanel');
    var divider = document.getElementById('BaDivider');
    var dragTarget = document.getElementById('BaDragTarget');
    if (!container || !afterPanel || !divider) return;

    var isDragging = false;
    var position = 50; // percentage

    function setPosition(pct) {
      pct = Math.min(95, Math.max(5, pct));
      position = pct;
      afterPanel.style.clipPath = 'inset(0 ' + (100 - pct) + '% 0 0)';
      divider.style.left = pct + '%';
    }

    function getPercent(clientX) {
      var rect = container.getBoundingClientRect();
      return ((clientX - rect.left) / rect.width) * 100;
    }

    // Initial
    setPosition(50);

    // Mouse events
    dragTarget.addEventListener('mousedown', function(e) {
      isDragging = true;
      e.preventDefault();
    });
    divider.addEventListener('mousedown', function(e) {
      isDragging = true;
      e.preventDefault();
    });
    document.addEventListener('mousemove', function(e) {
      if (!isDragging) return;
      setPosition(getPercent(e.clientX));
    });
    document.addEventListener('mouseup', function() { isDragging = false; });

    // Touch events
    dragTarget.addEventListener('touchstart', function(e) {
      isDragging = true;
    }, { passive: true });
    divider.addEventListener('touchstart', function(e) {
      isDragging = true;
    }, { passive: true });
    document.addEventListener('touchmove', function(e) {
      if (!isDragging) return;
      setPosition(getPercent(e.touches[0].clientX));
    }, { passive: true });
    document.addEventListener('touchend', function() { isDragging = false; });

    // Keyboard accessibility
    divider.setAttribute('tabindex', '0');
    divider.setAttribute('role', 'slider');
    divider.setAttribute('aria-label', 'تحريك الشريط للمقارنة');
    divider.setAttribute('aria-valuemin', '0');
    divider.setAttribute('aria-valuemax', '100');
    divider.setAttribute('aria-valuenow', '50');
    divider.addEventListener('keydown', function(e) {
      if (e.key === 'ArrowLeft') { setPosition(position + 5); divider.setAttribute('aria-valuenow', position); }
      if (e.key === 'ArrowRight') { setPosition(position - 5); divider.setAttribute('aria-valuenow', position); }
    });
  })();
</script>

{% schema %}
{
  "name": "نتائج قبل وبعد",
  "settings": [
    { "type": "text", "id": "badge", "label": "نص البادج", "default": "نتائج حقيقية" },
    { "type": "text", "id": "title", "label": "العنوان", "default": "تحول ملحوظ خلال 30 يوماً" },
    { "type": "textarea", "id": "subtitle", "label": "الوصف", "default": "اسحبي الشريط للمقارنة بين البشرة قبل وبعد استعمال سيروم فيتامين C العضوي" },
    { "type": "image_picker", "id": "image_before", "label": "صورة قبل الاستعمال" },
    { "type": "image_picker", "id": "image_after", "label": "صورة بعد الاستعمال" },
    { "type": "text", "id": "before_label", "label": "تسمية قبل", "default": "قبل" },
    { "type": "text", "id": "after_label", "label": "تسمية بعد", "default": "بعد" },
    { "type": "text", "id": "before_sub", "label": "وصف صورة قبل", "default": "بشرة مجهدة ودون إشراق" },
    { "type": "text", "id": "after_sub", "label": "وصف صورة بعد", "default": "نضارة فائقة وتوحيد لون البشرة" },
    { "type": "checkbox", "id": "show_stats", "label": "عرض الإحصاءات", "default": true },
    { "type": "text", "id": "stat_1_number", "label": "الإحصاء 1 — الرقم", "default": "93%" },
    { "type": "text", "id": "stat_1_label", "label": "الإحصاء 1 — الوصف", "default": "لاحظن تحسناً في نضارة البشرة" },
    { "type": "text", "id": "stat_2_number", "label": "الإحصاء 2 — الرقم", "default": "30" },
    { "type": "text", "id": "stat_2_label", "label": "الإحصاء 2 — الوصف", "default": "يوماً للحصول على نتيجة واضحة" },
    { "type": "text", "id": "stat_3_number", "label": "الإحصاء 3 — الرقم", "default": "+10K" },
    { "type": "text", "id": "stat_3_label", "label": "الإحصاء 3 — الوصف", "default": "عميلة سعيدة بالنتيجة" }
  ],
  "presets": [{ "name": "نتائج قبل وبعد" }]
}
{% endschema %}
