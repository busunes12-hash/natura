{% comment %}
  Section 9: Before & After Comparison Slider
  — Fully functional drag/touch slider via JS
  — Schema-controlled (merchant can edit all text from Customizer)
  — Shows styled placeholders if no photos uploaded
{% endcomment %}
{{ 'section-before-after.css' | asset_url | stylesheet_tag }}

<section class="before-after-section py-16 reveal-on-scroll" id="before-after">
  <div class="container">
    <div class="section-header">
      <span class="badge-forest mb-4" style="display: inline-flex;">{{ section.settings.badge | default: 'نتائج حقيقية ملموسة' }}</span>
      <h2 class="type-h2">{{ section.settings.title | default: 'ترطيب عميق وحماية حقيقية للبشرة والشعر' }}</h2>
      <p class="section-subtitle">{{ section.settings.subtitle | default: 'اسحب الشريط للمقارنة بين البشرة قبل وبعد الالتزام اليومي بالزيوت المغربية النقية' }}</p>
    </div>

    <div class="before-after-container" id="BeforeAfterSlider" aria-label="مقارنة قبل وبعد" role="img">

      <!-- BEFORE panel -->
      <div class="ba-image ba-image--before">
        {%- if section.settings.image_before != blank -%}
          <img
            src="{{ section.settings.image_before | image_url: width: 820, format: 'webp' }}"
            alt="{{ section.settings.before_label | default: 'قبل' }}"
            loading="lazy"
            width="820"
            height="461"
            style="width:100%;height:100%;object-fit:cover;"
          >
        {%- else -%}
          <img
            src="{{ 'skincare-before.jpg' | asset_url }}"
            alt="{{ section.settings.before_label | default: 'قبل الاستعمال' }}"
            loading="lazy"
            width="820"
            height="461"
            style="width:100%;height:100%;object-fit:cover;"
          >
        {%- endif -%}
      </div>

      <!-- AFTER panel -->
      <div class="ba-image ba-image--after" id="BaAfterPanel">
        {%- if section.settings.image_after != blank -%}
          <img
            src="{{ section.settings.image_after | image_url: width: 820, format: 'webp' }}"
            alt="{{ section.settings.after_label | default: 'بعد' }}"
            loading="lazy"
            width="820"
            height="461"
            style="width:100%;height:100%;object-fit:cover;"
          >
        {%- else -%}
          <img
            src="{{ 'skincare-after.jpg' | asset_url }}"
            alt="{{ section.settings.after_label | default: 'بعد 30 يوماً' }}"
            loading="lazy"
            width="820"
            height="461"
            style="width:100%;height:100%;object-fit:cover;"
          >
        {%- endif -%}
      </div>

      <!-- Divider + Handle -->
      <div class="ba-divider" id="BaDivider">
        <div class="ba-handle-circle">
          <div class="ba-handle-arrows">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><polyline points="9 6 15 12 9 18"></polyline></svg>
          </div>
        </div>
      </div>

      <!-- Labels -->
      <span class="ba-label ba-label--before" aria-hidden="true">{{ section.settings.before_label | default: 'قبل' }}</span>
      <span class="ba-label ba-label--after" aria-hidden="true">{{ section.settings.after_label | default: 'بعد' }}</span>

      <!-- Drag target -->
      <div class="ba-drag-target" id="BaDragTarget" aria-hidden="true"></div>
    </div>

    {%- if section.settings.show_stats -%}
    <div class="ba-stats">
      <div class="ba-stat">
        <span class="ba-stat__number">{{ section.settings.stat_1_number | default: '94%' }}</span>
        <span class="ba-stat__label">{{ section.settings.stat_1_label | default: 'لاحظن ترطيباً يدوم طوال اليوم' }}</span>
      </div>
      <div class="ba-stat">
        <span class="ba-stat__number">{{ section.settings.stat_2_number | default: '100%' }}</span>
        <span class="ba-stat__label">{{ section.settings.stat_2_label | default: 'زيوت مغربية نقية بدون إضافات' }}</span>
      </div>
      <div class="ba-stat">
        <span class="ba-stat__number">{{ section.settings.stat_3_number | default: '+15K' }}</span>
        <span class="ba-stat__label">{{ section.settings.stat_3_label | default: 'عائلة مغربية تستخدم منتجاتنا' }}</span>
      </div>
    </div>
    {%- endif -%}

  </div>
</section>

<style>
  .ba-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 2.5rem;
    text-align: center;
  }
  .ba-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }
  .ba-stat__number {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    color: var(--color-forest);
    line-height: 1;
  }
  .ba-stat__label {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    max-width: 180px;
    line-height: 1.5;
  }
  @media (max-width: 640px) {
    .ba-stats { grid-template-columns: 1fr; gap: 1.25rem; }
  }
</style>

<script>
  (function() {
    var slider = document.getElementById('BeforeAfterSlider');
    if (!slider) return;
    var afterPanel = document.getElementById('BaAfterPanel');
    var divider = document.getElementById('BaDivider');
    var dragTarget = document.getElementById('BaDragTarget');
    var isDragging = false;
    var position = 50;

    function setPosition(pct) {
      pct = Math.max(0, Math.min(100, pct));
      position = pct;
      afterPanel.style.clipPath = 'polygon(' + pct + '% 0, 100% 0, 100% 100%, ' + pct + '% 100%)';
      divider.style.right = pct + '%';
    }

    function getPercent(clientX) {
      var rect = slider.getBoundingClientRect();
      var x = clientX - rect.left;
      var pct = (1 - (x / rect.width)) * 100;
      return pct;
    }

    // Initial
    setPosition(50);

    // Mouse events
    dragTarget.addEventListener('mousedown', function(e) {
      isDragging = true;
      e.preventDefault();
    });
    divider.addEventListener('mousedown', function(e) {
      isDragging = true;
      e.preventDefault();
    });
    document.addEventListener('mousemove', function(e) {
      if (!isDragging) return;
      setPosition(getPercent(e.clientX));
    });
    document.addEventListener('mouseup', function() { isDragging = false; });

    // Touch events
    dragTarget.addEventListener('touchstart', function(e) {
      isDragging = true;
    }, { passive: true });
    divider.addEventListener('touchstart', function(e) {
      isDragging = true;
    }, { passive: true });
    document.addEventListener('touchmove', function(e) {
      if (!isDragging) return;
      setPosition(getPercent(e.touches[0].clientX));
    }, { passive: true });
    document.addEventListener('touchend', function() { isDragging = false; });

    // Keyboard accessibility
    divider.setAttribute('tabindex', '0');
    divider.setAttribute('role', 'slider');
    divider.setAttribute('aria-label', 'تحريك الشريط للمقارنة');
    divider.setAttribute('aria-valuemin', '0');
    divider.setAttribute('aria-valuemax', '100');
    divider.setAttribute('aria-valuenow', '50');
    divider.addEventListener('keydown', function(e) {
      if (e.key === 'ArrowLeft') { setPosition(position + 5); divider.setAttribute('aria-valuenow', position); }
      if (e.key === 'ArrowRight') { setPosition(position - 5); divider.setAttribute('aria-valuenow', position); }
    });
  })();
</script>

{% schema %}
{
  "name": "نتائج قبل وبعد",
  "settings": [
    { "type": "text", "id": "badge", "label": "نص البادج", "default": "نتائج حقيقية ملموسة" },
    { "type": "text", "id": "title", "label": "العنوان", "default": "ترطيب عميق وحماية حقيقية للبشرة والشعر" },
    { "type": "textarea", "id": "subtitle", "label": "الوصف", "default": "اسحب الشريط للمقارنة بين البشرة قبل وبعد الالتزام اليومي بالزيوت المغربية النقية" },
    { "type": "image_picker", "id": "image_before", "label": "صورة قبل الاستعمال" },
    { "type": "image_picker", "id": "image_after", "label": "صورة بعد الاستعمال" },
    { "type": "text", "id": "before_label", "label": "تسمية قبل", "default": "قبل" },
    { "type": "text", "id": "after_label", "label": "تسمية بعد", "default": "بعد" },
    { "type": "text", "id": "before_sub", "label": "وصف صورة قبل", "default": "بشرة جافة ومجهدة" },
    { "type": "text", "id": "after_sub", "label": "وصف صورة بعد", "default": "ترطيب عميق ونضارة حقيقية" },
    { "type": "checkbox", "id": "show_stats", "label": "عرض الإحصاءات", "default": true },
    { "type": "text", "id": "stat_1_number", "label": "الإحصاء 1 — الرقم", "default": "94%" },
    { "type": "text", "id": "stat_1_label", "label": "الإحصاء 1 — الوصف", "default": "لاحظن ترطيباً يدوم طوال اليوم" },
    { "type": "text", "id": "stat_2_number", "label": "الإحصاء 2 — الرقم", "default": "100%" },
    { "type": "text", "id": "stat_2_label", "label": "الإحصاء 2 — الوصف", "default": "زيوت مغربية نقية بدون إضافات" },
    { "type": "text", "id": "stat_3_number", "label": "الإحصاء 3 — الرقم", "default": "+15K" },
    { "type": "text", "id": "stat_3_label", "label": "الإحصاء 3 — الوصف", "default": "عائلة مغربية تستخدم منتجاتنا" }
  ],
  "presets": [{ "name": "نتائج قبل وبعد" }]
}
{% endschema %}
