{% comment %}
  Section 11: Press & Certifications
  Logos: Vogue Arabia, Harper's Bazaar, Cosmopolitan ME with hover opacity transition.
{% endcomment %}
<section class="press-section py-12 reveal-on-scroll" style="background-color: var(--color-bg-secondary); border-block: 1px solid #E8D5B7;">
  <div class="container">
    <div class="text-center mb-6 text-xs font-bold text-muted uppercase tracking-wider">
      كُتب عنا في كبرى مجلات الجمال والموضة العالمية
    </div>

    <div class="press-logos-flex flex flex-wrap items-center justify-center gap-12">
      <span class="press-logo font-bold text-xl tracking-tighter hover:opacity-100 opacity-60 transition-opacity">
        VOGUE ARABIA
      </span>
      <span class="press-logo font-bold text-xl tracking-tight hover:opacity-100 opacity-60 transition-opacity">
        HARPER'S BAZAAR
      </span>
      <span class="press-logo font-bold text-xl tracking-tight hover:opacity-100 opacity-60 transition-opacity">
        COSMOPOLITAN ME
      </span>
      <span class="press-logo font-bold text-xl tracking-tighter hover:opacity-100 opacity-60 transition-opacity">
        ELLE ARABIA
      </span>
    </div>
  </div>
</section>

<style>
  .press-logo {
    font-family: var(--font-heading);
    color: var(--color-charcoal-dark);
    cursor: default;
  }
</style>

{% schema %}
{
  "name": "الصحافة والشهادات",
  "settings": []
}
{% endschema %}
