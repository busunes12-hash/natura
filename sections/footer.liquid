{% comment %}
  Section 14: Black Luxury Footer
  — SVG logo (no emoji)
  — Proper footer grid with all columns
  — Token-based colors (no hardcoded hex values)
  — Real WhatsApp number placeholder (UPDATE BEFORE LAUNCH)
  — Schema-controlled settings
{% endcomment %}

<footer class="footer-section" style="background-color: var(--color-bg-dark); color: #CCCCCC;">
  <div class="container">
    <div class="footer-grid">

      <!-- Column 1: Brand Info -->
      <div class="footer-col footer-col--brand">
        <a href="{{ routes.root_url }}" class="footer-logo" aria-label="{{ shop.name }}">
          <div class="footer-logo__emblem">
            <svg viewBox="0 0 120 70" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="width:28px;height:18px;">
              <path d="M60 5 C46 22 48 42 58 54 C60 54 60 54 62 54 C72 42 74 22 60 5 Z" stroke="currentColor" stroke-width="3" fill="none"/>
              <path d="M60 5 L60 54" stroke="currentColor" stroke-width="2"/>
              <path d="M57 52 C38 48 20 38 15 22 C28 18 45 28 54 44 Z" stroke="currentColor" stroke-width="3" fill="none"/>
              <path d="M63 52 C82 48 100 38 105 22 C92 18 75 28 66 44 Z" stroke="currentColor" stroke-width="3" fill="none"/>
            </svg>
            <span class="footer-logo__name">{{ shop.name | default: 'NATURA' }}</span>
          </div>
        </a>
        <p class="footer-brand-desc">
          {{ section.settings.brand_desc | default: 'علامة مغربية موثوقة تقدم مستحضرات العناية الطبيعية 100% بالبشرة والشعر المصممة لرعاية وحماية عائلتكِ كل يوم.' }}
        </p>
        {% render 'social-icons' %}
      </div>

      <!-- Column 2: Quick Links -->
      <div class="footer-col">
        <h4 class="footer-col__heading">{{ section.settings.links_heading | default: 'عائلة ناتورا' }}</h4>
        <ul class="footer-links">
          <li><a href="{{ routes.root_url }}">الرئيسية</a></li>
          <li><a href="/collections/all">منتجات العناية الطبيعية</a></li>
          <li><a href="/pages/about">قصتنا ومصدر مكوناتنا</a></li>
          <li><a href="/blogs/news">نصائح العناية الطبيعية</a></li>
          <li><a href="/pages/contact">تواصل معنا والدعم</a></li>
        </ul>
      </div>

      <!-- Column 3: Customer Service -->
      <div class="footer-col">
        <h4 class="footer-col__heading">{{ section.settings.service_heading | default: 'الرعاية والاستفسارات' }}</h4>
        <ul class="footer-links">
          <li><a href="#faq">الأسئلة الشائعة حول الطلب</a></li>
          <li><a href="/pages/shipping">الشحن السريع للمدن المغربية</a></li>
          <li><a href="/pages/returns">ضمان الإشراقة 30 يوماً</a></li>
          <li><a href="/search">البحث في الموسوعة</a></li>
          <li>
            {%- assign footer_wa = section.settings.whatsapp_number | default: '212600000000' | replace: '+', '' | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', '' -%}
            <a
              href="https://wa.me/{{ footer_wa }}"
              target="_blank"
              rel="noopener noreferrer"
            >
              استشارة فورية عبر الواتساب
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 4: COD Trust Card -->
      <div class="footer-col">
        <div class="footer-cod-card">
          <div class="footer-cod-card__header">
            <span class="footer-cod-card__icon">{% render 'icon', name: 'truck' %}</span>
            <span>المعاينة قبل الدفع 100%</span>
          </div>
          <p class="footer-cod-card__desc">
            {{ section.settings.cod_text | default: 'افتحي شحنتكِ وتأكدي من سلامة المنتجات والعبوة الفاخرة بنفسكِ قبل دفع أي سنتيم للموزع.' }}
          </p>
        </div>
        <p class="footer-shipping-tag">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          توصيل آمن لجميع جهات مدن المملكة المغربية
        </p>
      </div>

    </div>

    <!-- Sub-footer -->
    <div class="footer-sub">
      <p class="footer-copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. جميع الحقوق محفوظة.
      </p>
      <div class="footer-legal-links">
        <a href="/pages/privacy">سياسة الخصوصية</a>
        <a href="/pages/terms">شروط الاستخدام</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-section {
    padding-block: var(--space-16) var(--space-8);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.8fr 0.9fr 1.1fr 1.4fr;
    gap: var(--space-12);
    align-items: start;
    padding-block-end: var(--space-12);
    border-block-end: 1px solid rgba(255, 255, 255, 0.06);
    margin-block-end: var(--space-8);
  }

  /* Footer logo — inherits color from parent link */
  .footer-logo {
    display: inline-flex;
    text-decoration: none;
    margin-block-end: var(--space-4);
  }

  .footer-logo__emblem {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: #6EE7A0; /* Soft green on dark — accessible contrast on #121714 */
  }

  .footer-logo__name {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.2rem;
    font-weight: 700;
    color: #FFFFFF;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    line-height: 1;
  }

  .footer-brand-desc {
    font-size: 0.9rem;
    line-height: 1.75;
    color: #AAAAAA;
    max-width: 300px;
    margin-block-end: var(--space-6);
    font-family: var(--font-body);
  }

  .footer-col__heading {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 700;
    color: #DDDDDD;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    margin-block-end: var(--space-5);
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-links a {
    color: #999999;
    font-size: 0.9rem;
    font-family: var(--font-body);
    text-decoration: none;
    transition: color var(--transition-base), padding-inline-start var(--transition-base);
    display: inline-flex;
    align-items: center;
    gap: var(--space-1-5);
  }

  .footer-links a:hover {
    color: #FFFFFF;
    padding-inline-start: var(--space-1-5);
  }

  .footer-cod-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    margin-block-end: var(--space-4);
  }

  .footer-cod-card__header {
    display: flex;
    align-items: center;
    gap: var(--space-2-5);
    font-weight: 700;
    color: var(--color-gold);
    font-size: 0.95rem;
    margin-block-end: var(--space-3);
    font-family: var(--font-body);
  }

  .footer-cod-card__icon {
    width: 18px;
    height: 18px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .footer-cod-card__desc {
    font-size: 0.85rem;
    line-height: 1.65;
    color: #999999;
    font-family: var(--font-body);
  }

  .footer-shipping-tag {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.825rem;
    color: #666666;
    font-family: var(--font-body);
  }

  .footer-sub {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .footer-copyright {
    font-size: 0.85rem;
    color: #555555;
    font-family: var(--font-body);
  }

  .footer-legal-links {
    display: flex;
    gap: var(--space-6);
  }

  .footer-legal-links a {
    font-size: 0.85rem;
    color: #555555;
    text-decoration: none;
    font-family: var(--font-body);
    transition: color var(--transition-base);
  }

  .footer-legal-links a:hover { color: #AAAAAA; }

  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
    }
  }

  @media (max-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
    .footer-sub {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .footer-brand-desc {
      max-width: none;
    }
  }
</style>

{% schema %}
{
  "name": "الفوتر الفاخر",
  "settings": [
    { "type": "textarea", "id": "brand_desc", "label": "وصف العلامة التجارية", "default": "علامة مغربية موثوقة تقدم مستحضرات العناية الطبيعية 100% بالبشرة والشعر لجميع أفراد العائلة." },
    { "type": "text", "id": "links_heading", "label": "عنوان عمود الروابط", "default": "روابط سريعة" },
    { "type": "text", "id": "service_heading", "label": "عنوان عمود الخدمات", "default": "خدمة العملاء" },
    { "type": "text", "id": "whatsapp_number", "label": "رقم الواتساب (بدون +)", "default": "212600000000", "info": "مثال: 212612345678 (رمز المغرب 212 ثم رقم الهاتف بدون صفر في البداية)" },
    { "type": "textarea", "id": "cod_text", "label": "نص بطاقة الدفع عند الاستلام" }
  ],
  "presets": [{ "name": "الفوتر الفاخر" }]
}
{% endschema %}
