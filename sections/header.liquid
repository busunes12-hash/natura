{% comment %}
  Section 2: Sticky Glassmorphism Header
  — SVG wordmark logo (no emoji)
  — Desktop nav with hover underline
  — Mobile hamburger triggering #MobileNavDrawer (defined in mobile-nav-drawer.liquid)
  — Search, Account, Wishlist, Cart icons (44×44px touch targets)
  — Scroll-aware class via JS
{% endcomment %}
{{ 'component-header.css' | asset_url | stylesheet_tag }}

<header class="header-wrapper" id="SiteHeader">
  <div class="container header">

    <!-- Mobile Menu Trigger -->
    <button
      type="button"
      class="header__icon-btn lg:hidden"
      aria-label="افتح القائمة الرئيسية"
      aria-expanded="false"
      aria-controls="MobileNavDrawer"
      onclick="document.querySelector('#MobileNavDrawer')?.open()"
    >
      {% render 'icon', name: 'menu' %}
    </button>

    <!-- Brand Logo -->
    <a href="{{ routes.root_url }}" class="header__logo" aria-label="{{ shop.name }} — الصفحة الرئيسية">
      <div class="header__logo-wrapper">
        <svg viewBox="0 0 40 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="header__logo-svg">
          <!-- 3 Botanical Leaves Crest -->
          <path d="M20 1C16.8 6.5 16.8 12.5 20 16C23.2 12.5 23.2 6.5 20 1Z" fill="currentColor"/>
          <path d="M18.8 10.5C12.8 8.5 8.5 12 8 18C13 19.5 17.5 16.5 18.8 10.5Z" fill="currentColor"/>
          <path d="M21.2 10.5C27.2 8.5 31.5 12 32 18C27 19.5 22.5 16.5 21.2 10.5Z" fill="currentColor"/>
        </svg>
        <span class="header__logo-text">{{ shop.name | default: 'NATURA' }}</span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="header__nav hidden lg:flex" aria-label="التنقل الرئيسي">
      <a href="{{ routes.root_url }}" class="header__nav-link{% if request.path == '/' %} is-active{% endif %}">الرئيسية</a>
      <a href="/collections/all" class="header__nav-link{% if request.path contains '/collections' %} is-active{% endif %}">المنتجات</a>
      <a href="/pages/contact" class="header__nav-link{% if request.path contains '/contact' %} is-active{% endif %}">اتصلي بنا</a>
    </nav>

    <!-- Header Icon Actions -->
    <div class="header__icons">

      <!-- Search -->
      <button
        type="button"
        class="header__icon-btn"
        aria-label="البحث في المتجر"
        id="SearchToggleBtn"
        onclick="window.location.href='{{ routes.search_url }}'"
      >
        {% render 'icon', name: 'search' %}
      </button>

      <!-- Account -->
      <a
        href="{{ routes.account_url }}"
        class="header__icon-btn"
        aria-label="{% if customer %}حسابي — {{ customer.first_name }}{% else %}تسجيل الدخول{% endif %}"
      >
        {% render 'icon', name: 'user' %}
      </a>

      <!-- Wishlist -->
      <button
        type="button"
        class="header__icon-btn header__icon-btn--wishlist"
        aria-label="قائمة الرغبات"
      >
        {% render 'icon', name: 'heart' %}
      </button>

      <!-- Cart -->
      <button
        type="button"
        class="header__icon-btn"
        aria-label="سلة التسوق — {{ cart.item_count }} منتج"
        aria-expanded="false"
        aria-controls="CartDrawer"
        onclick="document.querySelector('#CartDrawer')?.open()"
      >
        {% render 'icon', name: 'cart' %}
        <span
          class="header__cart-badge{% if cart.item_count == 0 %} hidden{% endif %}"
          data-cart-count
          aria-live="polite"
        >
          {{ cart.item_count }}
        </span>
      </button>

    </div>
  </div>
</header>

<script>
  (function() {
    var header = document.getElementById('SiteHeader');
    if (!header) return;
    var threshold = 80;
    function onScroll() {
      if (window.scrollY > threshold) {
        header.classList.add('is-scrolled');
      } else {
        header.classList.remove('is-scrolled');
      }
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
</script>

{% schema %}
{
  "name": "الهيدر الرئيسي",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "قائمة التنقل",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
