{% comment %}
  Section 10: Testimonials — Schema-controlled review cards
  — Gold star color
  — No hardcoded letter avatars
  — No flag emojis
  — CMS-editable via blocks
{% endcomment %}

<section id="testimonials" class="testimonials-section py-16 reveal-on-scroll" style="background-color: var(--color-bg-primary);">
  <div class="container">
    <div class="section-header">
      <span class="badge-terracotta mb-4" style="display: inline-flex;">{{ section.settings.badge | default: 'تجارب عائلاتنا' }}</span>
      <h2 class="type-h2">{{ section.settings.title | default: 'ماذا تقول العائلات المغربية عن ناتورا؟' }}</h2>
      <p class="section-subtitle">{{ section.settings.subtitle | default: 'أكثر من 1,500 تقييم حقيقي من عملاء يثقون في مكوناتنا الأصيلة' }}</p>
    </div>

    <div class="testimonials-carousel">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'review' -%}
            <div class="testimonial-card" {{ block.shopify_attributes }}>
              <!-- Stars -->
              <div class="testimonial-stars">
                {%- assign rating = block.settings.rating | default: 5 -%}
                {%- for i in (1..5) -%}
                  <svg width="16" height="16" viewBox="0 0 24 24"
                    fill="{% if i <= rating %}#D4AF37{% else %}#E8D5B7{% endif %}"
                    aria-hidden="true"
                  >
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                  </svg>
                {%- endfor -%}
                {%- if block.settings.verified -%}
                  <span class="verified-badge">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.78 4.78 4 4 0 0 1-6.74 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.74z"/><polyline points="9 12 11 14 15 10"/></svg>
                    شراء موثق
                  </span>
                {%- endif -%}
              </div>

              <!-- Review text -->
              <blockquote class="testimonial-text">
                "{{ block.settings.text | default: 'منتج رائع، لاحظت ترطيباً كبيراً ومكونات نقية منذ الأسبوع الأول.' }}"
              </blockquote>

              <!-- Author -->
              <div class="testimonial-author">
                <div class="testimonial-avatar" aria-hidden="true" style="background-color: var(--color-bg-secondary); color: var(--color-forest);">
                  {{ block.settings.name | slice: 0 }}
                </div>
                <div>
                  <p class="testimonial-author__name">{{ block.settings.name | default: 'عميل' }}</p>
                  {%- if block.settings.city != blank or block.settings.product != blank -%}
                    <p class="testimonial-author__meta text-xs text-muted">
                      {%- if block.settings.city != blank -%}{{ block.settings.city }}{%- endif -%}
                      {%- if block.settings.city != blank and block.settings.product != blank %} — {% endif -%}
                      {%- if block.settings.product != blank -%}{{ block.settings.product }}{%- endif -%}
                    </p>
                  {%- endif -%}
                </div>
              </div>
            </div>
        {%- endcase -%}
      {%- else -%}
        <!-- Default static testimonials -->
        <div class="testimonial-card">
          <div class="testimonial-stars">
            {%- for i in (1..5) -%}<svg width="16" height="16" viewBox="0 0 24 24" fill="#D4AF37" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>{%- endfor -%}
            <span class="verified-badge"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.78 4.78 4 4 0 0 1-6.74 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.74z"/><polyline points="9 12 11 14 15 10"/></svg>شراء موثق</span>
          </div>
          <blockquote class="testimonial-text">"استعملت زيت الأرغان النقي لشعر أطفالي وبشرتي. زيت أصلي وغير ثقيل، وأهم شيء أنني عاينت الطلب عند التوصيل قبل الدفع. شكراً ناتورا على الصدق."</blockquote>
          <div class="testimonial-author">
            <div class="testimonial-avatar" style="background-color: var(--color-bg-secondary); color: var(--color-forest);">أ</div>
            <div><p class="testimonial-author__name">أمينة التازي</p><p class="text-xs text-muted">الدار البيضاء — زيت الأرغان الأصلي</p></div>
          </div>
        </div>
        <div class="testimonial-card">
          <div class="testimonial-stars">
            {%- for i in (1..5) -%}<svg width="16" height="16" viewBox="0 0 24 24" fill="#D4AF37" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>{%- endfor -%}
            <span class="verified-badge"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.78 4.78 4 4 0 0 1-6.74 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.74z"/><polyline points="9 12 11 14 15 10"/></svg>شراء موثق</span>
          </div>
          <blockquote class="testimonial-text">"سيروم التين الشوكي رائع جداً وجعل بشرتي ناعمة ورطبة بدون أي حساسية. سعر مناسب جداً مقارنة بالجودة العالية والمكونات النقية."</blockquote>
          <div class="testimonial-author">
            <div class="testimonial-avatar" style="background-color: var(--color-bg-secondary); color: var(--color-forest);">خ</div>
            <div><p class="testimonial-author__name">خديجة بنجلون</p><p class="text-xs text-muted">مراكش — سيروم التين الشوكي</p></div>
          </div>
        </div>
        <div class="testimonial-card">
          <div class="testimonial-stars">
            {%- for i in (1..5) -%}<svg width="16" height="16" viewBox="0 0 24 24" fill="#D4AF37" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>{%- endfor -%}
            <span class="verified-badge"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.78 4.78 4 4 0 0 1-6.74 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.74z"/><polyline points="9 12 11 14 15 10"/></svg>شراء موثق</span>
          </div>
          <blockquote class="testimonial-text">"طلبت التشكيلة العائلية والتوصيل كان في أقل من 48 ساعة إلى طنجة. المنتجات آمنة جداً حتى على بشرة أطفالي الحساسة ونلاحظ فرقاً ملموساً في النعومة والترطيب."</blockquote>
          <div class="testimonial-author">
            <div class="testimonial-avatar" style="background-color: var(--color-bg-secondary); color: var(--color-forest);">س</div>
            <div><p class="testimonial-author__name">سناء البقالي</p><p class="text-xs text-muted">طنجة — التشكيلة العائلية</p></div>
          </div>
        </div>
        <div class="testimonial-card">
          <div class="testimonial-stars">
            {%- for i in (1..5) -%}<svg width="16" height="16" viewBox="0 0 24 24" fill="#C5A059" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>{%- endfor -%}
            <span class="verified-badge"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.78 4.78 4 4 0 0 1-6.74 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.74z"/><polyline points="9 12 11 14 15 10"/></svg>شراء موثق</span>
          </div>
          <blockquote class="testimonial-text">"في البداية كنت متخوفة من الشراء عبر الإنترنت، لكن إمكانية فتح الشحنة ومعاينتها قبل دفع المبلغ للموزع أعطتني ثقة مطلقة. الجودة تفوق الماركات العالمية الفرنسية بكثير."</blockquote>
          <div class="testimonial-author">
            <div class="testimonial-avatar" style="background-color: var(--color-bg-secondary); color: var(--color-forest);">م</div>
            <div><p class="testimonial-author__name">مريم بناني</p><p class="text-xs text-muted">مراكش — كريم التين الشوكي</p></div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .testimonials-carousel {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .testimonial-card {
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }
  .testimonial-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }
  .testimonial-stars {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex-wrap: wrap;
  }
  .verified-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-forest);
    background-color: rgba(var(--color-forest-rgb), 0.08);
    padding: var(--space-1) var(--space-2-5);
    border-radius: var(--radius-full);
    margin-inline-start: var(--space-2);
  }
  .testimonial-text {
    font-size: 0.95rem;
    line-height: 1.75;
    color: var(--color-charcoal-dark);
    font-style: italic;
    flex: 1;
  }
  .testimonial-author {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    border-block-start: 1px solid var(--color-border-subtle);
    padding-block-start: var(--space-4);
  }
  .testimonial-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.1rem;
    flex-shrink: 0;
  }
  .testimonial-author__name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--color-charcoal-dark);
  }
  @media (max-width: 1024px) {
    .testimonials-carousel { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .testimonials-carousel {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 1rem;
      -webkit-overflow-scrolling: touch;
      gap: 1rem;
    }
    .testimonial-card {
      min-width: 85%;
      scroll-snap-align: center;
    }
  }
</style>

{% schema %}
{
  "name": "آراء العميلات",
  "settings": [
    { "type": "text", "id": "badge", "label": "نص البادج", "default": "تجارب عائلاتنا" },
    { "type": "text", "id": "title", "label": "العنوان", "default": "ماذا تقول العائلات المغربية عن ناتورا؟" },
    { "type": "textarea", "id": "subtitle", "label": "الوصف", "default": "أكثر من 1,500 تقييم حقيقي من عملاء يثقون في مكوناتنا الأصيلة" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "تقييم",
      "settings": [
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "default": 5, "label": "التقييم" },
        { "type": "checkbox", "id": "verified", "label": "شراء موثق", "default": true },
        { "type": "textarea", "id": "text", "label": "نص التقييم" },
        { "type": "text", "id": "name", "label": "اسم العميلة" },
        { "type": "text", "id": "city", "label": "المدينة" },
        { "type": "text", "id": "product", "label": "المنتج المُقيَّم" }
      ]
    }
  ],
  "presets": [{ "name": "آراء العميلات" }]
}
{% endschema %}
