{% comment %}
  Renders pagination controls
{% endcomment %}
{%- if paginate.parts.size > 0 -%}
  <nav class="pagination flex items-center justify-center gap-2 py-8" aria-label="الصفحات">
    {%- if paginate.previous -%}
      <a href="{{ paginate.previous.url }}" class="btn-secondary py-2 px-4 text-sm" aria-label="الصفحة السابقة">
        السابقة
      </a>
    {%- endif -%}

    {%- for part in paginate.parts -%}
      {%- if part.is_link -%}
        <a href="{{ part.url }}" class="py-2 px-4 rounded-md border border-forest hover:bg-forest hover:text-white">
          {{ part.title }}
        </a>
      {%- else -%}
        {%- if part.title == paginate.current_page -%}
          <span class="py-2 px-4 rounded-md bg-forest text-white font-bold" aria-current="page">
            {{ part.title }}
          </span>
        {%- else -%}
          <span class="py-2 px-4 text-muted">{{ part.title }}</span>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if paginate.next -%}
      <a href="{{ paginate.next.url }}" class="btn-secondary py-2 px-4 text-sm" aria-label="الصفحة التالية">
        التالية →
      </a>
    {%- endif -%}
  </nav>
{%- endif -%}
