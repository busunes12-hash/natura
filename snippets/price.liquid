{% comment %}
  Renders product price in Moroccan Dirham (د.م.) with exact Dirham savings badge — Quiet Luxury Refinement
  Usage: {% render 'price', product: product %}
{% endcomment %}
{%- liquid
  assign target = product
  if target.price_varies
    assign price = target.price_min
  else
    assign price = target.price
  endif
  assign compare_at_price = target.compare_at_price
-%}

{%- if target != blank -%}
  <div class="price-container flex items-baseline gap-3 flex-wrap">
    <span class="price-item price-item--sale">
      {{ price | money_without_currency | default: '199' }} د.م.
    </span>

    {%- if compare_at_price > price -%}
      <s class="price-item price-item--regular">
        {{ compare_at_price | money_without_currency }} د.م.
      </s>
      {%- assign savings_amount = compare_at_price | minus: price -%}
      {%- assign savings_pct = savings_amount | times: 100 | divided_by: compare_at_price -%}
      <span class="badge-terracotta">
        وفري {{ savings_amount | money_without_currency }} د.م. ({{ savings_pct }}%-)
      </span>
    {%- endif -%}
  </div>
{%- endif -%}

<style>
  .price-container {
    padding-block: 0.25rem;
  }

  .price-item--sale {
    font-family: var(--font-heading);
    color: var(--color-forest);
    font-weight: 700;
    font-size: 1.5rem;
    letter-spacing: -0.01em;
  }

  .price-item--regular {
    color: var(--color-text-muted);
    font-size: 1rem;
    text-decoration: line-through;
    opacity: 0.7;
  }
</style>
