{% comment %}
  Reusable product card component
  Usage: {% render 'product-card', product: product %}
{% endcomment %}
{{ 'component-card.css' | asset_url | stylesheet_tag }}

<div class="product-card">
  <div class="product-card__image-wrapper">
    {%- if product.featured_media -%}
      <img
        src="{{ product.featured_media | image_url: width: 600 }}"
        srcset="{{ product.featured_media | image_url: width: 300 }} 300w, {{ product.featured_media | image_url: width: 600 }} 600w"
        sizes="(max-width: 640px) 50vw, 33vw"
        alt="{{ product.featured_media.alt | default: product.title | escape }}"
        class="product-card__image"
        loading="lazy"
        width="600"
        height="600"
      >
    {%- else -%}
      <div class="product-card__placeholder flex items-center justify-center h-full bg-cream text-forest">
        {% render 'icon', name: 'leaf' %}
      </div>
    {%- endif -%}

    {%- if product.compare_at_price > product.price -%}
      <div class="product-card__badge">
        <span class="badge-terracotta">تخفيض 🌿</span>
      </div>
    {%- endif -%}
  </div>

  <div class="product-card__content">
    <div>
      <h3 class="product-card__title">
        <a href="{{ product.url }}">{{ product.title }}</a>
      </h3>

      <div class="product-card__rating flex items-center gap-1 mb-2">
        {% render 'icon', name: 'star' %}
        <span class="text-xs font-bold text-forest">4.9/5 (1,240 تقييم)</span>
      </div>

      {% render 'price', product: product %}
    </div>

    <button
      type="button"
      class="btn-primary product-card__quick-add"
      data-quick-add="{{ product.selected_or_first_available_variant.id }}"
      aria-label="إضافة {{ product.title }} للسلة"
    >
      <span class="btn-text">إضافة للسلة 🛒</span>
    </button>
  </div>
</div>
