{% comment %}
  Reusable product card component
  Usage: {% render 'product-card', product: product %}
  — Real review data (no hardcoded fake ratings)
  — Percentage discount badge
  — Wishlist button
  — Gold stars
{% endcomment %}
{{ 'component-card.css' | asset_url | stylesheet_tag }}

{%- assign has_discount = false -%}
{%- if product.compare_at_price > product.price -%}
  {%- assign has_discount = true -%}
  {%- assign savings_pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price | round -%}
{%- endif -%}

<div class="product-card" itemscope itemtype="https://schema.org/Product">
  <meta itemprop="name" content="{{ product.title | escape }}">
  <meta itemprop="image" content="{{ product.featured_media | image_url: width: 800 }}">
  <div itemprop="offers" itemscope itemtype="https://schema.org/AggregateOffer" class="hidden">
    <meta itemprop="priceCurrency" content="MAD">
    <meta itemprop="lowPrice" content="{{ product.price_min | divided_by: 100.0 }}">
    <meta itemprop="highPrice" content="{{ product.price_max | divided_by: 100.0 }}">
    <meta itemprop="offerCount" content="{{ product.variants.size }}">
  </div>
  <div class="product-card__image-wrapper">

    {%- if product.featured_media -%}
      <img
        src="{{ product.featured_media | image_url: width: 600, format: 'webp' }}"
        srcset="
          {{ product.featured_media | image_url: width: 300, format: 'webp' }} 300w,
          {{ product.featured_media | image_url: width: 600, format: 'webp' }} 600w,
          {{ product.featured_media | image_url: width: 900, format: 'webp' }} 900w
        "
        sizes="(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 25vw"
        alt="{{ product.featured_media.alt | default: product.title | escape }}"
        class="product-card__image product-card__image--primary"
        loading="lazy"
        width="600"
        height="600"
      >
      {%- if product.media[1] -%}
        <img
          src="{{ product.media[1] | image_url: width: 600, format: 'webp' }}"
          alt="{{ product.media[1].alt | default: product.title | escape }}"
          class="product-card__image product-card__image--secondary"
          loading="lazy"
          width="600"
          height="600"
        >
      {%- endif -%}
    {%- else -%}
      <img
        src="{{ 'vitamin-c-serum.jpg' | asset_url }}"
        alt="{{ product.title | default: shop.name | escape }}"
        class="product-card__image product-card__image--primary"
        loading="lazy"
        width="600"
        height="600"
      >
    {%- endif -%}

    <!-- Discount badge (percentage) -->
    {%- if has_discount -%}
      <div class="product-card__discount" aria-label="خصم {{ savings_pct }}%">
        خصم {{ savings_pct }}%
      </div>
    {%- endif -%}

    <!-- COD Trust Badge -->
    <div class="product-card__cod-badge" style="position: absolute; bottom: 8px; right: 8px; background: rgba(27, 59, 43, 0.9); color: #fff; font-size: 10px; font-weight: 700; padding: 2px 8px; border-radius: 12px; backdrop-filter: blur(4px);">
      COD متوفر
    </div>

    <!-- Wishlist button -->
    <button
      type="button"
      class="product-card__wishlist"
      aria-label="أضيفي {{ product.title | escape }} إلى المفضلة"
      data-wishlist-toggle
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
      </svg>
    </button>

  </div>

  <div class="product-card__content">
    <div>
      <h3 class="product-card__title">
        <a href="{{ product.url }}">{{ product.title }}</a>
      </h3>

      <!-- Reviews — only show if metafield or app provides real data -->
      {%- if product.metafields.reviews.rating.value != blank -%}
        <div class="product-card__rating">
          {%- assign rating_val = product.metafields.reviews.rating.value | round: 1 -%}
          {%- assign rating_count = product.metafields.reviews.rating_count.value | default: 0 -%}
          {%- for i in (1..5) -%}
            <svg width="14" height="14" viewBox="0 0 24 24"
              fill="{% if i <= rating_val %}#D4AF37{% else %}#E8D5B7{% endif %}"
              aria-hidden="true"
            >
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
          {%- endfor -%}
          <span class="text-xs font-bold" style="color: var(--color-text-muted);">{{ rating_val }} ({{ rating_count }})</span>
        </div>
      {%- endif -%}

      {% render 'price', product: product %}
    </div>

    <button
      type="button"
      class="btn-primary product-card__quick-add"
      data-quick-add="{{ product.selected_or_first_available_variant.id }}"
      aria-label="إضافة {{ product.title | escape }} للسلة"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="flex-shrink:0;">
        <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
      </svg>
      <span class="btn-text">إضافة للسلة</span>
    </button>
  </div>
</div>
