{% comment %}
  RTL breadcrumb navigation snippet
{% endcomment %}
<nav class="breadcrumb py-4 text-sm font-medium text-muted" aria-label="مسار التنقل">
  <ol class="flex items-center gap-1 list-none">
    <li>
      <a href="{{ routes.root_url }}" class="hover:text-forest">الرئيسية</a>
    </li>
    <li aria-hidden="true" style="padding-inline: 0.5rem; opacity: 0.5;">/</li>
    {%- if template.name == 'product' -%}
      {%- if collection.url -%}
        <li>
          <a href="{{ collection.url }}" class="hover:text-forest">{{ collection.title }}</a>
        </li>
        <li aria-hidden="true" style="padding-inline: 0.5rem; opacity: 0.5;">/</li>
      {%- endif -%}
      <li aria-current="page" class="text-forest font-bold">{{ product.title }}</li>
    {%- elsif template.name == 'collection' and collection.handle -%}
      <li aria-current="page" class="text-forest font-bold">{{ collection.title }}</li>
    {%- endif -%}
  </ol>
</nav>

<!-- Schema.org BreadcrumbList JSON-LD Structured Data -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "الرئيسية",
      "item": {{ shop.url | append: routes.root_url | json }}
    }
    {%- if template.name == 'product' -%}
      {%- if collection.url -%},
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ collection.title | json }},
        "item": {{ shop.url | append: collection.url | json }}
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": {{ product.title | json }},
        "item": {{ shop.url | append: product.url | json }}
      }
      {%- else -%},
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ product.title | json }},
        "item": {{ shop.url | append: product.url | json }}
      }
      {%- endif -%}
    {%- elsif template.name == 'collection' and collection.handle -%},
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ collection.title | json }},
        "item": {{ shop.url | append: collection.url | json }}
      }
    {%- endif -%}
  ]
}
</script>
