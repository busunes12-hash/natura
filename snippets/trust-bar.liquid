{% comment %}
  Secondary inline trust bar snippet
{% endcomment %}
<div class="trust-bar-inline flex items-center justify-between gap-4 py-4 px-6 rounded-full border" style="border-color: #E8D5B7; background: var(--color-bg-surface);">
  <div class="trust-item flex items-center gap-2">
    {% render 'icon', name: 'truck' %}
    <span class="text-xs font-bold">🇲🇦 الدفع عند الاستلام بالمغرب</span>
  </div>
  <div class="trust-item flex items-center gap-2">
    {% render 'icon', name: 'flask' %}
    <span class="text-xs font-bold">🔬 مختبر طبياً 100%</span>
  </div>
  <div class="trust-item flex items-center gap-2">
    {% render 'icon', name: 'shield' %}
    <span class="text-xs font-bold">🚚 توصيل 24-48 ساعة</span>
  </div>
  <div class="trust-item flex items-center gap-2">
    {% render 'icon', name: 'leaf' %}
    <span class="text-xs font-bold">🌿 مكونات عضوية فاخرة</span>
  </div>
</div>
