{% comment %}
  🌿 Snippet: 1-Click Accelerated Direct COD Order Capture Form
  Target Market: Morocco (Arabic / Cash-On-Delivery)
  Phase 4 Rebuild: No emojis, full SVG icons, token-based variables, clean validation
{% endcomment %}

<div class="cod-express-container my-6 p-5 rounded-xl bg-surface border border-subtle-token shadow-md" id="QuickCODForm">
  <div class="cod-express-header mb-4 text-center">
    <span class="inline-flex items-center gap-1.5 text-xs font-bold px-3 py-1 rounded-full badge-terracotta-subtle mb-2">
      <span class="w-3.5 h-3.5 inline-flex items-center justify-center">{% render 'icon', name: 'sparkle' %}</span>
      <span>الطلب المباشر السريع (في 30 ثانية)</span>
    </span>
    <h3 class="type-h3 text-xl font-extrabold text-dark leading-tight">
      أدخلي تفاصيل الاستلام وسنتواصل معكِ فوراً للتأكيد والتوصيل
    </h3>
    <p class="text-xs text-muted mt-1">
      الدفع نقداً عند الاستلام | معاينة الشحنة قبل التسليم 100%
    </p>
  </div>

  <form action="/apps/cod-order-create" method="POST" id="DirectCODExpressForm" class="flex flex-col gap-3.5">
    <input type="hidden" name="variant_id" id="CodVariantId" value="{{ product.selected_or_first_available_variant.id }}">
    <input type="hidden" name="quantity" id="CodQuantity" value="1">
    <input type="hidden" name="bundle_tier" id="CodBundleTier" value="1">

    <div class="form-group flex flex-col gap-1">
      <label for="CodCustomerName" class="text-xs font-bold text-dark">
        الاسم الكامل <span class="text-terracotta">*</span>
      </label>
      <input 
        type="text" 
        id="CodCustomerName" 
        name="customer_name" 
        placeholder="مثال: ليلى التازي" 
        required 
        class="form-input w-full px-3.5 py-2.5 rounded-lg border border-subtle-token text-sm focus:outline-none transition"
      >
    </div>

    <div class="form-group flex flex-col gap-1">
      <label for="CodCustomerPhone" class="text-xs font-bold text-dark">
        رقم الهاتف (واتساب) <span class="text-terracotta">*</span>
      </label>
      <input 
        type="tel" 
        id="CodCustomerPhone" 
        name="phone" 
        placeholder="0600 000 000" 
        pattern="^(06|07|05)[0-9]{8}$" 
        required 
        class="form-input w-full px-3.5 py-2.5 rounded-lg border border-subtle-token text-sm focus:outline-none transition"
        dir="ltr"
      >
      <span class="text-[11px] text-muted">سنرسل لكِ تفاصيل التتبع فور إرسال الطلب عبر الواتساب</span>
    </div>

    <div class="form-group flex flex-col gap-1">
      <label for="CodCustomerCity" class="text-xs font-bold text-dark">
        المدينة <span class="text-terracotta">*</span>
      </label>
      <select 
        id="CodCustomerCity" 
        name="city" 
        required 
        class="form-select w-full px-3.5 py-2.5 rounded-lg border border-subtle-token text-sm bg-surface focus:outline-none transition"
      >
        <option value="">إختاري مدينتكِ</option>
        <option value="الدار البيضاء">الدار البيضاء (توصيل خلال 24 ساعة - مجاني)</option>
        <option value="الرباط">الرباط / سلا (توصيل خلال 24 ساعة - مجاني)</option>
        <option value="مراكش">مراكش (توصيل خلال 24-48 ساعة)</option>
        <option value="طنجة">طنجة (توصيل خلال 24-48 ساعة)</option>
        <option value="أكادير">أكادير (توصيل خلال 48 ساعة)</option>
        <option value="فاس">فاس (توصيل خلال 48 ساعة)</option>
        <option value="مكناس">مكناس (توصيل خلال 48 ساعة)</option>
        <option value="وجدة">وجدة (توصيل خلال 48 ساعة)</option>
        <option value="القنيطرة">القنيطرة (توصيل خلال 24-48 ساعة)</option>
        <option value="تطوان">تطوان (توصيل خلال 48 ساعة)</option>
        <option value="أخرى">مدينة أخرى بالمملكة (توصيل 48 ساعة)</option>
      </select>
    </div>

    <div class="form-group flex flex-col gap-1">
      <label for="CodAddress" class="text-xs font-bold text-dark">
        العنوان (الحي، الشارع، ورقم الإقامة) <span class="text-terracotta">*</span>
      </label>
      <input 
        type="text" 
        id="CodAddress" 
        name="address" 
        placeholder="مثال: حي المعاريف، شارع المسيرة الخضراء، إقامة..." 
        required
        class="form-input w-full px-3.5 py-2.5 rounded-lg border border-subtle-token text-sm focus:outline-none transition"
      >
      <span class="text-[11px] text-muted">ضروري لضمان وصول الموزع لباب منزلكِ خلال 24 ساعة</span>
    </div>

    <button 
      type="submit" 
      id="CodSubmitBtn"
      class="btn-primary w-full py-4 px-6 rounded-full font-bold text-white text-base shadow-lg transition flex items-center justify-between cursor-pointer mt-2"
    >
      <div class="flex items-center gap-2">
        <span class="w-5 h-5 inline-flex items-center justify-center">{% render 'icon', name: 'cart' %}</span>
        <span>تأكيد الطلب الآن — الدفع بعد المعاينة</span>
      </div>
      <span id="CodFormTotalBadge" class="text-xs font-extrabold px-2.5 py-1 rounded-full bg-white/20 text-white whitespace-nowrap">
        {{ product.price | default: 19900 | money_without_currency }} د.م.
      </span>
    </button>

    <div class="cod-guarantees-grid grid grid-cols-3 gap-2 text-center mt-3 pt-3 border-t border-subtle-token">
      <div class="flex flex-col items-center gap-1">
        <span class="w-5 h-5 text-forest inline-flex items-center justify-center">{% render 'icon', name: 'truck' %}</span>
        <span class="text-[10px] font-bold text-dark">توصيل سريع</span>
      </div>
      <div class="flex flex-col items-center gap-1">
        <span class="w-5 h-5 text-forest inline-flex items-center justify-center">{% render 'icon', name: 'shield' %}</span>
        <span class="text-[10px] font-bold text-dark">معاينة قبل الدفع</span>
      </div>
      <div class="flex flex-col items-center gap-1">
        <span class="w-5 h-5 text-forest inline-flex items-center justify-center">{% render 'icon', name: 'badge-check' %}</span>
        <span class="text-[10px] font-bold text-dark">تأكيد واتساب</span>
      </div>
    </div>
    <div id="CodSuccessBox" class="hidden my-4 p-5 rounded-xl bg-cream border border-forest text-center flex-col items-center gap-2">
      <span class="w-8 h-8 text-forest inline-flex items-center justify-center">{% render 'icon', name: 'badge-check' %}</span>
      <h4 class="font-bold text-base text-forest">تم تسجيل طلبكِ بنجاح!</h4>
      <p class="text-xs text-muted leading-relaxed">شكراً لثقتكِ. سيتصل بكِ فريق خدمة العملاء خلال ساعات لتأكيد العنوان وموعد التوصيل.</p>
    </div>
  </form>
</div>

<script>
  (function() {
    var form = document.getElementById('DirectCODExpressForm');
    if (!form) return;
    var phoneInput = document.getElementById('CodCustomerPhone');
    var submitBtn = document.getElementById('CodSubmitBtn');
    var successBox = document.getElementById('CodSuccessBox');
    
    form.addEventListener('submit', function(e) {
      if (!phoneInput) return;
      var cleanPhone = phoneInput.value.replace(/[\s\-\(\)]/g, '');
      var moroccoPhoneRegex = /^(06|07|05)[0-9]{8}$/;
      
      if (!moroccoPhoneRegex.test(cleanPhone)) {
        e.preventDefault();
        alert('الرجاء إدخال رقم هاتف مغربي صحيح مكون من 10 أرقام ويبدأ بـ 06 أو 07 أو 05 (مثال: 0661123456)');
        phoneInput.focus();
        return false;
      }

      e.preventDefault();
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.style.opacity = '0.7';
      }

      var formData = new FormData(form);
      var name = formData.get('customer_name') || '';
      var phone = cleanPhone;
      var city = formData.get('city') || '';
      var address = formData.get('address') || '';
      var variantId = formData.get('variant_id');
      var qty = parseInt(formData.get('quantity') || '1', 10);

      // Attempt endpoint post
      fetch(form.action, {
        method: 'POST',
        body: formData
      })
      .then(function(res) {
        if (!res.ok) throw new Error('Proxy not configured');
        return res.json();
      })
      .then(function() {
        showSuccess();
      })
      .catch(function() {
        // Fallback: save to cart attributes & open WhatsApp confirmation
        var root = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
        var cleanRoot = root.endsWith('/') ? root : root + '/';
        
        fetch(cleanRoot + 'cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: variantId,
            quantity: qty,
            properties: {
              'نوع الطلب': 'طلب مباشر بالدفع عند الاستلام',
              'الاسم الكامل': name,
              'رقم الهاتف': phone,
              'المدينة': city,
              'العنوان': address
            }
          })
        }).finally(function() {
          showSuccess();
          var waNumber = '{{ settings.whatsapp_number | default: "212600000000" }}';
          var prodTitle = '{{ product.title | escape }}';
          var waMsg = 'مرحباً ناتورا، قمت بطلب ' + prodTitle + ' بالدفع عند الاستلام:\nالاسم: ' + name + '\nالهاتف: ' + phone + '\nالمدينة: ' + city + '\nالعنوان: ' + address;
          setTimeout(function() {
            window.open('https://wa.me/' + waNumber + '?text=' + encodeURIComponent(waMsg), '_blank');
          }, 800);
        });
      });

      function showSuccess() {
        if (submitBtn) submitBtn.style.display = 'none';
        if (successBox) {
          successBox.classList.remove('hidden');
          successBox.style.display = 'flex';
        }
      }
    });
  })();
</script>
