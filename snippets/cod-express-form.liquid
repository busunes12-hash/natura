{% comment %}
  🌿 Snippet: 1-Click Accelerated Direct COD Order Capture Form
  Target Market: Morocco (Arabic / Cash-On-Delivery)
{% endcomment %}

<div class="cod-express-container my-6 p-5 rounded-xl shadow-md bg-white border border-stone-200" id="QuickCODForm">
  <div class="cod-express-header mb-4 text-center">
    <span class="inline-flex items-center gap-1.5 text-xs font-bold px-3 py-1 rounded-full bg-amber-100 text-amber-900 mb-2">
      ⚡ الطلب المباشر السريع (في 30 ثانية)
    </span>
    <h3 class="type-h3 text-xl font-extrabold text-stone-900 leading-tight">
      أدخلي معلوماتك وسنتصل بكِ لتأكيد الطلب والتوصيل
    </h3>
    <p class="text-xs text-stone-600 mt-1">
      الدفع نقداً عند الاستلام | معاينة الشحنة قبل التسليم 100%
    </p>
  </div>

  <form action="/apps/cod-order-create" method="POST" id="DirectCODExpressForm" class="flex flex-col gap-3.5">
    <input type="hidden" name="variant_id" id="CodVariantId" value="{{ product.selected_or_first_available_variant.id }}">
    <input type="hidden" name="quantity" id="CodQuantity" value="1">
    <input type="hidden" name="bundle_tier" id="CodBundleTier" value="1">

    <div class="form-group flex flex-col gap-1">
      <label for="CodCustomerName" class="text-xs font-bold text-stone-800">
        الاسم الكامل <span class="text-red-600">*</span>
      </label>
      <input 
        type="text" 
        id="CodCustomerName" 
        name="customer_name" 
        placeholder="مثال: ليلى التازي" 
        required 
        class="w-full px-3.5 py-2.5 rounded-lg border border-stone-300 text-sm focus:outline-none focus:border-emerald-800 transition"
      >
    </div>

    <div class="form-group flex flex-col gap-1">
      <label for="CodCustomerPhone" class="text-xs font-bold text-stone-800">
        رقم الهاتف (واتساب) <span class="text-red-600">*</span>
      </label>
      <input 
        type="tel" 
        id="CodCustomerPhone" 
        name="phone" 
        placeholder="06XX XXX XXX" 
        pattern="^(06|07|05)[0-9]{8}$" 
        required 
        class="w-full px-3.5 py-2.5 rounded-lg border border-stone-300 text-sm focus:outline-none focus:border-emerald-800 transition"
        dir="ltr"
      >
      <span class="text-[11px] text-stone-500">سنرسل لكِ تفاصيل التتبع فور إرسال الطلب عبر الواتساب</span>
    </div>

    <div class="form-group flex flex-col gap-1">
      <label for="CodCustomerCity" class="text-xs font-bold text-stone-800">
        المدينة <span class="text-red-600">*</span>
      </label>
      <select 
        id="CodCustomerCity" 
        name="city" 
        required 
        class="w-full px-3.5 py-2.5 rounded-lg border border-stone-300 text-sm bg-white focus:outline-none focus:border-emerald-800 transition"
      >
        <option value="">إختاري مدينتكِ</option>
        <option value="Casablanca">الدار البيضاء (توصيل خلال 24 ساعة - مجاني)</option>
        <option value="Rabat">الرباط / سلا (توصيل خلال 24 ساعة - مجاني)</option>
        <option value="Marrakech">مراكش (توصيل خلال 24-48 ساعة)</option>
        <option value="Tangier">طنجة (توصيل خلال 24-48 ساعة)</option>
        <option value="Agadir">أكادير (توصيل خلال 48 ساعة)</option>
        <option value="Fes">فاس (توصيل خلال 48 ساعة)</option>
        <option value="Meknes">مكناس (توصيل خلال 48 ساعة)</option>
        <option value="Oujda">وجدة (توصيل خلال 48 ساعة)</option>
        <option value="Kenitra">القنيطرة (توصيل خلال 24-48 ساعة)</option>
        <option value="Tetouan">تطوان (توصيل خلال 48 ساعة)</option>
        <option value="Other">مدينة أخرى بالمملكة (توصيل 48 ساعة)</option>
      </select>
    </div>

    <div class="form-group flex flex-col gap-1">
      <label for="CodAddress" class="text-xs font-bold text-stone-800">
        العنوان (الحي / الشارع) <span class="text-stone-400 font-normal">(اختياري)</span>
      </label>
      <input 
        type="text" 
        id="CodAddress" 
        name="address" 
        placeholder="مثال: حي المعاريف، زنقة..." 
        class="w-full px-3.5 py-2.5 rounded-lg border border-stone-300 text-sm focus:outline-none focus:border-emerald-800 transition"
      >
    </div>

    <button 
      type="submit" 
      class="cod-submit-btn w-full py-4 px-6 rounded-full font-bold text-white text-base shadow-lg transition flex items-center justify-center gap-2 cursor-pointer mt-2"
      style="background: linear-gradient(135deg, #1B3B2B 0%, #12271C 100%);"
    >
      <span>🛒 تأكيد الطلب الآن — الدفع بعد المعاينة</span>
    </button>

    <div class="cod-guarantees-grid grid grid-cols-3 gap-2 text-center mt-3 pt-3 border-t border-stone-100">
      <div class="flex flex-col items-center gap-1">
        <span class="text-lg">🚚</span>
        <span class="text-[10px] font-bold text-stone-700">توصيل سريع</span>
      </div>
      <div class="flex flex-col items-center gap-1">
        <span class="text-lg">🔍</span>
        <span class="text-[10px] font-bold text-stone-700">معاينة قبل الدفع</span>
      </div>
      <div class="flex flex-col items-center gap-1">
        <span class="text-lg">💬</span>
        <span class="text-[10px] font-bold text-stone-700">تأكيد واتساب</span>
      </div>
    </div>
  </form>
</div>
