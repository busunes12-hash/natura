{% comment %}
  Social Media Icon links snippet
{% endcomment %}
<div class="social-icons flex gap-3" style="display: flex; gap: 0.75rem; justify-content: flex-start;">
  <a href="#" class="social-icon-btn flex items-center justify-center text-white" aria-label="أنستغرام" style="width: 42px; height: 42px; background: rgba(255,255,255,0.08); border-radius: 50%; display: flex; align-items: center; justify-content: center; transition: all 0.3s ease; text-decoration: none;">
    <span class="w-4 h-4 inline-flex items-center justify-center">{% render 'icon', name: 'sparkle' %}</span>
  </a>
  <a href="https://wa.me/212600000000" class="social-icon-btn flex items-center justify-center text-white" aria-label="واتساب" style="width: 42px; height: 42px; background: rgba(255,255,255,0.08); border-radius: 50%; display: flex; align-items: center; justify-content: center; transition: all 0.3s ease; text-decoration: none;">
    <span class="w-4 h-4 inline-flex items-center justify-center">{% render 'icon', name: 'truck' %}</span>
  </a>
</div>
