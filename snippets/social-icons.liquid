{% comment %}
  Social Media Icon links snippet
{% endcomment %}
{%- assign raw_wa_number = settings.whatsapp_number | default: '212600000000' -%}
{%- assign clean_wa_number = raw_wa_number | replace: '+', '' | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', '' -%}

<div class="social-icons flex gap-3" style="display: flex; gap: 0.75rem; justify-content: flex-start;">
  <a href="#" class="social-icon-btn flex items-center justify-center text-white" aria-label="أنستغرام" style="width: 42px; height: 42px; background: rgba(255,255,255,0.08); border-radius: 50%; display: flex; align-items: center; justify-content: center; transition: all 0.3s ease; text-decoration: none;">
    <span class="w-4 h-4 inline-flex items-center justify-center" style="width: 20px; height: 20px;">{% render 'icon', name: 'sparkle' %}</span>
  </a>
  <a href="https://wa.me/{{ clean_wa_number }}" target="_blank" rel="noopener noreferrer" class="social-icon-btn flex items-center justify-center text-white" aria-label="واتساب" style="width: 42px; height: 42px; background: #25D366; border-radius: 50%; display: flex; align-items: center; justify-content: center; transition: all 0.3s ease; text-decoration: none;">
    <span class="w-4 h-4 inline-flex items-center justify-center" style="width: 20px; height: 20px; color: #FFF;">{% render 'icon', name: 'whatsapp' %}</span>
  </a>
</div>

