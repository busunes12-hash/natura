{% comment %}
  Dynamic stock scarcity badge snippet — Quiet Luxury Refinement
{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- if current_variant.available == false -%}
  <div class="stock-scarcity-badge stock-scarcity-badge--soldout" style="background-color: var(--color-bg-secondary); color: var(--color-text-muted); border-color: var(--color-border-subtle);">
    <span class="scarcity-icon">{% render 'icon', name: 'sparkle' %}</span>
    <span>نفد المخزون حالياً — جاري عصر وتحضير دفعة طازجة جديدة</span>
  </div>
{%- elsif current_variant.inventory_management != blank and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= 10 -%}
  <div class="stock-scarcity-badge">
    <span class="scarcity-icon">{% render 'icon', name: 'sparkle' %}</span>
    <span>وجبة إنتاج طازجة محدودة: باقي {{ current_variant.inventory_quantity }} قوارير فقط من دفعة هذا الأسبوع المعصورة على البارد</span>
  </div>
{%- else -%}
  <div class="stock-scarcity-badge">
    <span class="scarcity-icon">{% render 'icon', name: 'sparkle' %}</span>
    <span>دفعة نادرة معصورة على البارد: متوفر كمية محدودة لليوم فقط بالمغرب</span>
  </div>
{%- endif -%}

<style>
  .stock-scarcity-badge {
    padding: 0.85rem 1.15rem;
    border-radius: var(--radius-md);
    background-color: var(--color-terracotta-soft);
    color: var(--color-terracotta);
    border: 1px solid rgba(184, 107, 73, 0.18);
    font-size: 0.875rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    line-height: 1.45;
  }

  .scarcity-icon {
    width: 1.15rem;
    height: 1.15rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
</style>
