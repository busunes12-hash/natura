{% comment %}
  🌿 Snippet: Clinical Trial Results & Dermatological Testing Showcase
  Phase 4: SVG icons, token colors, quiet luxury presentation
{% endcomment %}

<div class="clinical-results-card my-5 p-4.5 rounded-xl bg-cream border border-subtle-token">
  <div class="clinical-header flex items-center justify-between mb-3">
    <div class="flex items-center gap-2">
      <span class="w-4 h-4 text-forest inline-flex items-center justify-center">{% render 'icon', name: 'flask' %}</span>
      <h4 class="text-xs font-bold text-dark uppercase tracking-wide">
        نتائج دراسة سريرية مثبتة (على 50 إمرأة مغربية)
      </h4>
    </div>
    <span class="text-[10px] font-semibold badge-forest">
      مختبر جلدياً
    </span>
  </div>

  <div class="clinical-stats-grid grid grid-cols-3 gap-2.5 text-center">
    <div class="clinical-stat-item p-2.5 rounded-lg bg-surface shadow-xs border border-subtle-token">
      <span class="block text-xl font-extrabold text-forest" dir="ltr">98%</span>
      <span class="block text-[11px] text-muted font-medium leading-snug mt-1">ترطيب عميق يدوم 24 ساعة</span>
    </div>
    <div class="clinical-stat-item p-2.5 rounded-lg bg-surface shadow-xs border border-subtle-token">
      <span class="block text-xl font-extrabold text-forest" dir="ltr">94%</span>
      <span class="block text-[11px] text-muted font-medium leading-snug mt-1">إشراقة وتوحيد لون البشرة</span>
    </div>
    <div class="clinical-stat-item p-2.5 rounded-lg bg-surface shadow-xs border border-subtle-token">
      <span class="block text-xl font-extrabold text-forest" dir="ltr">91%</span>
      <span class="block text-[11px] text-muted font-medium leading-snug mt-1">انخفاض ملحوظ في الخطوط</span>
    </div>
  </div>
</div>
