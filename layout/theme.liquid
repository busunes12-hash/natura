<!doctype html>
<html class="no-js" lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#2D5F3E">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    <!-- Google Fonts Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=Noto+Kufi+Arabic:wght@600;700;800&display=swap" rel="stylesheet">

    <!-- LCP Hero Photography Preload (Performance optimization strategy 8.1) -->
    {%- if template.name == 'index' -%}
      <link rel="preload" as="image" href="{{ 'luxury-hero-skincare.jpg' | asset_url }}">
    {%- endif -%}

    <!-- CSS Theme Assets -->
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'utilities.css' | asset_url | stylesheet_tag }}
    {{ 'rtl-enforcer.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.Shopify = window.Shopify || {};
      window.Shopify.routes = window.Shopify.routes || { root: '{{ routes.root_url }}' };
    </script>

    <!-- Global JavaScript Web Components -->
    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'component-cart.js' | asset_url }}" defer="defer"></script>
  </head>

  <body class="template-{{ template.name }}">
    <!-- Accessibility Skip Link -->
    <a class="skip-to-content-link" href="#MainContent">
      الانتقال إلى المحتوى الرئيسي
    </a>

    <!-- Master SVG Icons Catalog -->
    {% render 'icons' %}

    <!-- Section 1: Announcement Bar -->
    {% section 'announcement-bar' %}

    <!-- Section 2: Sticky Header -->
    {% section 'header' %}

    <!-- Main Content Area -->
    <main id="MainContent" class="content-for-layout focus-none" tabindex="-1">
      {{ content_for_layout }}
    </main>

    <!-- Section 14: Black Luxury Footer -->
    {% section 'footer' %}

    <!-- Slide-Out Cart Drawer Component -->
    {% section 'cart-drawer' %}

    <!-- Modals & Popups -->
    {% section 'popup-newsletter' %}
    {% section 'popup-cookie-consent' %}

    <!-- WhatsApp Floating CTA Button -->
    {% render 'whatsapp-button' %}
  </body>
</html>
