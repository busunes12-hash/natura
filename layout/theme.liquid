<!doctype html>
<html class="no-js" lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#2D5F3E">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- else -%}
      <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 120 70'%3E%3Cpath d='M60 5 C46 22 48 42 58 54 C60 54 60 54 62 54 C72 42 74 22 60 5 Z' fill='%232D5F3E'/%3E%3Cpath d='M57 52 C38 48 20 38 15 22 C28 18 45 28 54 44 Z' fill='%232D5F3E'/%3E%3Cpath d='M63 52 C82 48 100 38 105 22 C92 18 75 28 66 44 Z' fill='%232D5F3E'/%3E%3C/svg%3E">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- else -%}
      <meta name="description" content="{{ shop.name }} — مستحضرات عناية طبيعية فاخرة مصنوعة في المغرب. زيوت عضوية، سيرومات، وكريمات مختبرة جلدياً. الدفع عند الاستلام في جميع المدن المغربية.">
    {%- endif -%}

    <!-- Google Fonts: Preconnect + Swap -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&family=Noto+Kufi+Arabic:wght@600;700;800&display=swap"
      rel="stylesheet"
    >

    <!-- LCP Hero Preload (homepage only) -->
    {%- if template.name == 'index' -%}
      <link rel="preload" as="image" href="{{ 'luxury-hero-skincare.jpg' | asset_url }}">
    {%- endif -%}

    <!-- Core CSS -->
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'utilities.css' | asset_url | stylesheet_tag }}
    {{ 'rtl-enforcer.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }},
      "logo": {
        "@type": "ImageObject",
        "url": {{ shop.url | append: '/assets/luxury-hero-skincare.jpg' | json }}
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer service",
        "availableLanguage": ["Arabic", "French"]
      },
      "areaServed": "MA"
    }
    </script>

    {%- if template.name == 'index' -%}
    {%- capture search_action_url -%}{{ shop.url }}/search?q={%- raw -%}{search_term_string}{%- endraw -%}{%- endcapture -%}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": {{ search_action_url | json }}
        },
        "query-input": "required name=search_term_string"
      }
    }
    </script>
    {%- endif -%}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.Shopify = window.Shopify || {};
      window.Shopify.routes = window.Shopify.routes || { root: '{{ routes.root_url }}' };
    </script>

    <!-- JS -->
    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'component-cart.js' | asset_url }}" defer="defer"></script>
  </head>

  <body class="template-{{ template.name }}">
    <!-- Accessibility Skip Link -->
    <a class="skip-to-content-link" href="#MainContent">الانتقال إلى المحتوى الرئيسي</a>

    <!-- Master SVG Icon Sprite -->
    {% render 'icons' %}

    <!-- Announcement Bar -->
    {% section 'announcement-bar' %}

    <!-- Sticky Header -->
    {% section 'header' %}

    <!-- Mobile Nav Drawer -->
    {% section 'mobile-nav-drawer' %}

    <!-- Main Content -->
    <main id="MainContent" class="content-for-layout focus-none" tabindex="-1">
      {{ content_for_layout }}
    </main>

    <!-- Footer -->
    {% section 'footer' %}

    <!-- Cart Drawer -->
    {% section 'cart-drawer' %}

    <!-- Popups -->
    {% section 'popup-newsletter' %}
    {% section 'popup-cookie-consent' %}

    <!-- WhatsApp Floating Button -->
    {% render 'whatsapp-button' %}
  </body>
</html>
